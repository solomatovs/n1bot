{
    "editor.formatOnSave": true,
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true
    },
    "black-formatter.path": [
        "${workspaceFolder}/.venv/bin/black"
    ],
    "python.analysis.extraPaths": [
        "src/domain/src",
        "src/app/src",
        "src/adapters/src",
        "src/infra/src",
        "src/api/src",
        "src/chainlit/src"
    ]
}
