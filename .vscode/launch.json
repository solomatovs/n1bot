{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Test AgentLoop",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_agent_loop.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/.vscode",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": ["прочитай список файлов в системе и объясни что они значат?"],
            "env": {
                "BOBA_CONFIG": "./config/config.toml",
                "LITELLM_API_KEY_FILE": "./secrets/litellm_api_key",
                "PYTHONPATH": "${workspaceFolder}/src/domain/src:${workspaceFolder}/src/app/src:${workspaceFolder}/src/adapters/src:${workspaceFolder}/src/infra/src:${workspaceFolder}/src/api/src:${workspaceFolder}/src/chainlit/src"
            }
        },
        {
            "name": "Pytest: current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/.vscode",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": ["-v", "${file}"],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src/domain/src:${workspaceFolder}/src/app/src:${workspaceFolder}/src/adapters/src:${workspaceFolder}/src/infra/src:${workspaceFolder}/src/api/src:${workspaceFolder}/src/chainlit/src"
            }
        },
    ]
}
