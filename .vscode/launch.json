{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Boba API",
            "type": "debugpy",
            "request": "launch",
            "module": "boba_api",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/.vscode",
            "python": "${workspaceFolder}/.venv/bin/python",
            "jinja": true,
            "env": {
                "BOBA_CONFIG": "./config/config.toml",
                "LITELLM_API_KEY_FILE": "./secrets/litellm_api_key",
                "CONFLUENCE_TOKEN_FILE": "./secrets/confluence_token",
                "PYTHONPATH": "${workspaceFolder}/src/boba-domain/src:${workspaceFolder}/src/boba-app/src:${workspaceFolder}/src/boba-adapters/src:${workspaceFolder}/src/boba-infra/src:${workspaceFolder}/src/boba-api/src:${workspaceFolder}/src/boba-chainlit/src"
            }
        },
        {
            "name": "Boba Chainlit",
            "type": "debugpy",
            "request": "launch",
            "module": "boba_chainlit",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/.vscode",
            "python": "${workspaceFolder}/.venv/bin/python",
            "autoStartBrowser": false,
            "jinja": true,
            "env": {
                "BOBA_CONFIG": "./config/config.toml",
                "LITELLM_API_KEY_FILE": "./secrets/litellm_api_key",
                "CONFLUENCE_TOKEN_FILE": "./secrets/confluence_token",
                "CHAINLIT_APP_ROOT": "./chainlit",
                "CHAINLIT_AUTH_SECRET_FILE": "./secrets/chainlit_auth_secret",
                "PYTHONPATH": "${workspaceFolder}/src/boba-domain/src:${workspaceFolder}/src/boba-app/src:${workspaceFolder}/src/boba-adapters/src:${workspaceFolder}/src/boba-infra/src:${workspaceFolder}/src/boba-api/src:${workspaceFolder}/src/boba-chainlit/src"
            }
        }
    ]
}
