{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "model",
            "type": "pickString",
            "description": "LiteLLM модель",
            "default": "qwen3.5-35b",
            "options": [
                "qwen3-0.6b",
                "qwen3.5-35b",
                "llama3.1:8b-instruct-fp16",
                "llama3.1-8b",
                "qwen2.5-14b",
            ]
        },
        {
            "id": "query",
            "type": "pickString",
            "description": "Запрос",
            "default": "Прочитай список файлов на файловой системе и объясни о чем в них говориться?",
            "options": [
                "Прочитай список файлов на файловой системе и объясни о чем в них говориться?",
                "Как именовать таблицы в adqm? прочитай это в файлах и объясни простым языком",
                "Прочитай файл 950276.html и расскажи как именовать таблицы в adqm на основе его содержимого?",
            ]
        }
    ],
    "configurations": [
        {
            "name": "Test AgentLoop (boba)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_agent_loop_integration.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/.vscode",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "--model", "${input:model}",
                "--temperature", "0.2",
                "--top-p", "0.95",
                "--presence-penalty", "0.0",
                "--frequency-penalty", "0.0",
                "${input:query}"
            ],
            "envFile": "${workspaceFolder}/local/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src/domain/src:${workspaceFolder}/src/app/src:${workspaceFolder}/src/adapters/src:${workspaceFolder}/src/infra/src",
                "BOBA_PROMPTS_DIR": "${workspaceFolder}/prompts"
            }
        },
        {
            "name": "Pytest: current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/.vscode",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": ["-v", "${file}"],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src/domain/src:${workspaceFolder}/src/app/src:${workspaceFolder}/src/adapters/src:${workspaceFolder}/src/infra/src"
            }
        },
        {
            "name": "Chainlit: Boba UI",
            "type": "debugpy",
            "request": "launch",
            "module": "chainlit",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/.vscode",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "run",
                "${workspaceFolder}/src/chainlit/src/boba/chainlit/app.py",
                "-h",
                "--host", "0.0.0.0",
                "--port", "8502",
                "--root-path", "/boba-debug"
            ],
            "envFile": "${workspaceFolder}/local/.env",
            "env": {
                "CHAINLIT_APP_ROOT": "${workspaceFolder}/src/chainlit",
                "PYTHONPATH": "${workspaceFolder}/src/domain/src:${workspaceFolder}/src/app/src:${workspaceFolder}/src/adapters/src:${workspaceFolder}/src/infra/src:${workspaceFolder}/src/chainlit/src",
                "BOBA_PROMPTS_DIR": "${workspaceFolder}/prompts"
            }
        }
    ]
}
