{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Streamlit: app.py (port 8502)",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run", "${workspaceFolder}/src/ui/app.py",
                "--server.port=8502",
                "--server.address=0.0.0.0",
                "--server.headless=true"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/docker",
            "envFile": "${workspaceFolder}/docker/env/.env.debug",
            "python": "${workspaceFolder}/.venv/bin/python",
            "jinja": true,
            "env": { "LOG_LEVEL": "DEBUG" }
        },
    ]
}
