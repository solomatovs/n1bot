{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "model",
            "type": "pickString",
            "description": "LiteLLM модель",
            "default": "qwen3.5-35b",
            "options": [
                "qwen3.5:9b",
                "qwen3.5-35b",
                "llama3.1:8b-instruct-fp16",
                "llama3.1-8b",
                "qwen2.5-14b"
            ]
        },
        {
            "id": "query",
            "type": "pickString",
            "description": "Запрос",
            "default": "Прочитай список файлов на файловой системе и объясни о чем в них говориться?",
            "options": [
                "Прочитай список файлов на файловой системе и объясни о чем в них говориться?",
                "Как именовать таблицы в adqm? прочитай это в файлах и объясни простым языком",
                "Прочитай файл 950276.html и расскажи как именовать таблицы в adqm на основе его содержимого?"
            ]
        }
    ],
    "configurations": [
        {
            "name": "Agent: run query",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.agent_run",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--cli.model=${input:model}",
                "--cli.query=${input:query}"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Chainlit: Boba UI",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.web.chainlit",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--chainlit.host=0.0.0.0",
                "--chainlit.port=8502",
                "--chainlit.root_path=/boba-debug"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Pytest: current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "-v",
                "${file}"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Pytest: integration (current file)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "-v",
                "-rs",
                "-m", "integration",
                "${file}"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Python current file",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "program": "${file}"
        }
    ]
}
