{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "model",
            "type": "pickString",
            "description": "LiteLLM модель",
            "default": "qwen3.5:9b",
            "options": [
                "qwen3.5:9b",
                "qwen3.5-35b",
                "llama3.1:8b-instruct-fp16",
                "llama3.1-8b",
                "qwen2.5-14b",
            ]
        },
        {
            "id": "query",
            "type": "pickString",
            "description": "Запрос",
            "default": "Прочитай список файлов на файловой системе и объясни о чем в них говориться?",
            "options": [
                "Прочитай список файлов на файловой системе и объясни о чем в них говориться?",
                "Как именовать таблицы в adqm? прочитай это в файлах и объясни простым языком",
                "Прочитай файл 950276.html и расскажи как именовать таблицы в adqm на основе его содержимого?",
            ]
        },
        {
            "id": "indexPath",
            "type": "promptString",
            "description": "Путь к файлу или директории для индексации",
            "default": "${workspaceFolder}/local/docs"
        },
        {
            "id": "indexCollection",
            "type": "promptString",
            "description": "Имя коллекции в ChromaDB",
            "default": "docs"
        },
        {
            "id": "indexDescription",
            "type": "promptString",
            "description": "Описание коллекции (применяется только при создании)",
            "default": "Документы, проиндексированные оператором"
        },
        {
            "id": "confluencePageIds",
            "type": "promptString",
            "description": "Confluence page-id(s) через запятую",
            "default": "98305"
        },
        {
            "id": "confluenceSpaceKey",
            "type": "promptString",
            "description": "Confluence space key (например DOCS, ds)",
            "default": "ds"
        },
        {
            "id": "confluenceCql",
            "type": "promptString",
            "description": "Confluence CQL-запрос",
            "default": "space = ds AND type = page"
        }
    ],
    "configurations": [
        {
            "name": "Agent: run query",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.agent_run",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--agent-run-model", "${input:model}",
                "--agent-run-temperature", "0.2",
                "--agent-run-top-p", "0.95",
                "--agent-run-presence-penalty", "0.0",
                "--agent-run-frequency-penalty", "0.0",
                "--agent-run-query", "${input:query}"
            ],
            "envFile": "${workspaceFolder}/local/.env",
        },
        {
            "name": "Vector Index: index FS path",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.vector_index",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--vector_index.action=index",
                "--vector_index.collection=${input:indexCollection}",
                "--vector_index.description=${input:indexDescription}",
                "--vector_index.source=ext.fs",
                "--indexer.sources.fs.paths=${input:indexPath}"
            ],
            "envFile": "${workspaceFolder}/local/.env",
        },
        {
            "name": "Vector Index: Confluence (pages)",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.vector_index",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--vector_index.action=index",
                "--vector_index.collection=${input:indexCollection}",
                "--vector_index.description=${input:indexDescription}",
                "--vector_index.source=ext.confluence_pages",
                "--indexer.sources.confluence.pages.page_ids=${input:confluencePageIds}"
            ],
            "envFile": "${workspaceFolder}/local/.env",
        },
        {
            "name": "Vector Index: Confluence (space)",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.vector_index",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--vector_index.action=index",
                "--vector_index.collection=${input:indexCollection}",
                "--vector_index.description=${input:indexDescription}",
                "--vector_index.source=ext.confluence_space",
                "--indexer.sources.confluence.space.space_key=${input:confluenceSpaceKey}"
            ],
            "envFile": "${workspaceFolder}/local/.env",
        },
        {
            "name": "Vector Index: Confluence (CQL)",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.vector_index",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--vector_index.action=index",
                "--vector_index.collection=${input:indexCollection}",
                "--vector_index.description=${input:indexDescription}",
                "--vector_index.source=ext.confluence_cql",
                "--indexer.sources.confluence.cql.cql=${input:confluenceCql}"
            ],
            "envFile": "${workspaceFolder}/local/.env",
        },
        {
            "name": "Vector Index: Sync Confluence space",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.vector_index",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--vector_index.action=sync",
                "--vector_index.collection=${input:indexCollection}",
                "--vector_index.source=ext.confluence_space",
                "--indexer.sources.confluence.space.space_key=${input:confluenceSpaceKey}"
            ],
            "envFile": "${workspaceFolder}/local/.env",
        },
        {
            "name": "Chainlit: Boba UI",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.web.chainlit",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--chainlit-host", "0.0.0.0",
                "--chainlit-port", "8502",
                "--chainlit-root-path", "/boba-debug"
            ],
            "envFile": "${workspaceFolder}/local/.env",
        },
        {
            "name": "Pytest: current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "-v",
                "${file}"
            ],
            "envFile": "${workspaceFolder}/local/.env",
        },
        {
            "name": "Pytest: test_e2e_extension.py",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "-v",
                "${workspaceFolder}/tests/confignext/test_e2e_extension.py"
            ],
            "envFile": "${workspaceFolder}/local/.env",
        },
        {
            "name": "Python current file",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/docs",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "program": "${file}"
        },
    ]
}
