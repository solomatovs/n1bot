{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Chainlit: agent",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/packages/agents/boba-chainlit/src/boba/chainlit/main.py",
            "console": "integratedTerminal",
            "jinja": true,
            "cwd": "${workspaceFolder}/compose",
            "python": "${workspaceFolder}/.venv/bin/python",
            "env": {
                "PATH": "${workspaceFolder}/.venv/bin:${workspaceFolder}/compose/third/bin:${env:PATH}",
                "BOBA_BASE": "${workspaceFolder}/compose",
                "BOBA_APP": "${workspaceFolder}/packages",
                "BOBA_PORT": "8601",
                "BOBA_URL_PREFIX": "/boba-debug",
                "BOBA_CGROUP_BASE": "/sys/fs/cgroup/boba.slice/boba-sandbox"
            },
            "justMyCode": false,
            "stopOnEntry": false
        },
        {
            "name": "pytest: текущий файл",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/compose",
            "python": "${workspaceFolder}/.venv/bin/python",
            "env": {
                "PATH": "${workspaceFolder}/.venv/bin:${workspaceFolder}/compose/third/bin:${env:PATH}",
                "BOBA_BASE": "${workspaceFolder}/compose",
                "BOBA_APP": "${workspaceFolder}/packages",
                "BOBA_PORT": "8601",
                "BOBA_URL_PREFIX": "/boba-debug",
                "BOBA_CGROUP_BASE": "/sys/fs/cgroup/boba.slice/boba-sandbox"
            },
            "justMyCode": false,
            "args": [
                "${file}",
                "-v"
            ]
        },
        {
            "name": "pytest: все тесты",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/compose",
            "python": "${workspaceFolder}/.venv/bin/python",
            "env": {
                "PATH": "${workspaceFolder}/.venv/bin:${workspaceFolder}/compose/third/bin:${env:PATH}",
                "BOBA_BASE": "${workspaceFolder}/compose",
                "BOBA_APP": "${workspaceFolder}/packages",
                "BOBA_PORT": "8601",
                "BOBA_URL_PREFIX": "/boba-debug",
                "BOBA_CGROUP_BASE": "/sys/fs/cgroup/boba.slice/boba-sandbox"
            },
            "justMyCode": false,
            "args": [
                "${workspaceFolder}/packages",
                "-q"
            ]
        },
        {
            "name": "pytest: интеграционные (живые сервисы)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/compose",
            "python": "${workspaceFolder}/.venv/bin/python",
            "env": {
                "PATH": "${workspaceFolder}/.venv/bin:${workspaceFolder}/compose/third/bin:${env:PATH}",
                "BOBA_BASE": "${workspaceFolder}/compose",
                "BOBA_APP": "${workspaceFolder}/packages",
                "BOBA_PORT": "8601",
                "BOBA_URL_PREFIX": "/boba-debug",
                "BOBA_CGROUP_BASE": "/sys/fs/cgroup/boba.slice/boba-sandbox"
            },
            "justMyCode": false,
            "args": [
                "${workspaceFolder}/packages/agents/boba-chainlit/tests/test_tools_integration.py",
                "-m",
                "integration",
                "-v"
            ]
        }
    ]
}
