{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Chainlit: agent",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/packages/agents/boba-chainlit/src/boba/chainlit/main.py",
            "console": "integratedTerminal",
            "jinja": true,
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "envFile": "${workspaceFolder}/.vscode/boba-debug.env",
            "env": {
                "PATH": "${workspaceFolder}/.venv/bin:${workspaceFolder}/release/current/third/bin:${env:PATH}"
            },
            "justMyCode": false,
            "stopOnEntry": false
        },
        {
            "name": "Ingest: Confluence целиком (OCR, полное пересоздание)",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.chainlit.cli.ingest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "envFile": "${workspaceFolder}/.vscode/boba-debug.env",
            "env": {
                "PATH": "${workspaceFolder}/.venv/bin:${workspaceFolder}/release/current/third/bin:${env:PATH}"
            },
            "justMyCode": false,
            "args": [
                "--mode", "spaces",
                "--target", "IPKD,DQ,PIXBI,TMETA,PHDD2",
                "--ocr-enabled",
                "--ocr-language", "rus+eng",
                "--num-workers", "2",
                "--force-update",
                "--prune-missing"
            ]
        },
        {
            "name": "Ingest: одна страница (OCR, без prune)",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.chainlit.cli.ingest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "envFile": "${workspaceFolder}/.vscode/boba-debug.env",
            "env": {
                "PATH": "${workspaceFolder}/.venv/bin:${workspaceFolder}/release/current/third/bin:${env:PATH}"
            },
            "justMyCode": false,
            "args": [
                "--mode", "pages",
                "--target", "983049",
                "--ocr-enabled",
                "--ocr-language", "rus+eng",
                "--num-workers", "2",
                "--force-update"
            ]
        },
        {
            "name": "pytest: текущий файл",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "envFile": "${workspaceFolder}/.vscode/boba-debug.env",
            "env": {
                "PATH": "${workspaceFolder}/.venv/bin:${workspaceFolder}/release/current/third/bin:${env:PATH}"
            },
            "justMyCode": false,
            "args": [
                "${file}",
                "-v"
            ]
        },
        {
            "name": "pytest: все тесты",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "envFile": "${workspaceFolder}/.vscode/boba-debug.env",
            "env": {
                "PATH": "${workspaceFolder}/.venv/bin:${workspaceFolder}/release/current/third/bin:${env:PATH}"
            },
            "justMyCode": false,
            "args": [
                "${workspaceFolder}/packages",
                "-q"
            ]
        },
        {
            "name": "pytest: интеграционные (живые сервисы)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "envFile": "${workspaceFolder}/.vscode/boba-debug.env",
            "env": {
                "PATH": "${workspaceFolder}/.venv/bin:${workspaceFolder}/release/current/third/bin:${env:PATH}"
            },
            "justMyCode": false,
            "args": [
                "${workspaceFolder}/packages/agents/boba-chainlit/tests/test_tools_integration.py",
                "-m",
                "integration",
                "-v"
            ]
        },
        {
            "name": "Python: current file",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "program": "${file}"
        }
    ]
}
