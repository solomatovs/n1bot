{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Chainlit: agent",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.chainlit",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/.vscode",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "env": {
                "BOBA_CONFIG_PATH":"${workspaceFolder}/.vscode/local/chainlit-debug.toml",
                "CHAINLIT_APP_ROOT":"${workspaceFolder}/.vscode/local",
                "KRB5_CONFIG": "${workspaceFolder}/local/krb5.conf",
            }
        },
        {
            "name": "Chainlit2: agent",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/packages/agents/boba-chainlit2/src/boba/chainlit2/main.py",
            "console": "integratedTerminal",
            "jinja": true,
            "cwd": "${workspaceFolder}/.vscode",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "stopOnEntry": false,
            "env": {
                "BOBA_CONFIG_PATH":"${workspaceFolder}/.vscode/local/chainlit2-debug.toml",
                "CHAINLIT_APP_ROOT":"${workspaceFolder}/.vscode/local",
                "KRB5_CONFIG": "${workspaceFolder}/local/krb5.conf",
            }
        },
        {
            "name": "Chainlit2: pytest current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/.vscode",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "${file}",
                "-v"
            ],
            "env": {
                "BOBA_CONFIG_PATH": "${workspaceFolder}/.vscode/local/chainlit2-debug.toml",
                "CHAINLIT_APP_ROOT": "${workspaceFolder}/.vscode/local",
                "KRB5_CONFIG": "${workspaceFolder}/local/krb5.conf"
            }
        },
        {
            // chainlit запускается здесь, а gateway берётся из docker-compose:
            // конфиг ходит в него на 127.0.0.1:8642 (проброшенный порт)
            "name": "Hermes: agent",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.hermes.main",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/.vscode",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "env": {
                "BOBA_CONFIG_PATH": "${workspaceFolder}/.vscode/local/hermes-debug.toml",
                "CHAINLIT_APP_ROOT": "${workspaceFolder}/.vscode/local",
                // KRB5_CONFIG не задаём: контейнерный krb5.conf указывает на
                // dc1.loshara.com, который с хоста не резолвится. системный
                // /etc/krb5.conf ходит в KDC через loshara.com:443
                // postgres пускает только по kerberos: GSSAPI сам берёт тикет
                // из keytab доменной учётки, kinit руками не нужен
                "KRB5_CLIENT_KTNAME": "${workspaceFolder}/build/local/keytab/boba-svc.keytab",
                "KRB5CCNAME": "FILE:/tmp/krb5cc_boba_hermes_debug",
                "PGGSSENCMODE": "prefer"
            }
        },
        {
            "name": "Hermes: pytest current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/.vscode",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "${file}",
                "-v"
            ],
            "env": {
                "BOBA_CONFIG_PATH": "${workspaceFolder}/.vscode/local/hermes-debug.toml",
                "CHAINLIT_APP_ROOT": "${workspaceFolder}/.vscode/local",
                "KRB5_CLIENT_KTNAME": "${workspaceFolder}/build/local/keytab/boba-svc.keytab",
                "KRB5CCNAME": "FILE:/tmp/krb5cc_boba_hermes_debug",
                "PGGSSENCMODE": "prefer"
            }
        },
        {
            "name": "Agent CLI: agent",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.agent",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/.vscode",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "env": {
                "BOBA_CONFIG_PATH":"${workspaceFolder}/.vscode/local/chainlit-debug.toml"
            }
        },
        {
            "name": "KB CLI: kb_bootstrap",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.tool.kb.cli.kb_bootstrap",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/.vscode",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "env": {
                "BOBA_CONFIG_PATH":"${workspaceFolder}/.vscode/local/chainlit-debug.toml",
                "CHAINLIT_APP_ROOT":"${workspaceFolder}/.vscode/local"
            }
        },
        {
            "name": "Python: current file",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/.vscode",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "program": "${file}"
        }
    ],
}