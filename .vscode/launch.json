{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "model",
            "type": "pickString",
            "description": "LiteLLM модель",
            "default": "qwen3.5-35b",
            "options": [
                "qwen3-0.6b",
                "qwen3.5-35b",
                "llama3.1:8b-instruct-fp16",
                "llama3.1-8b",
                "qwen2.5-14b",
            ]
        },
        {
            "id": "query",
            "type": "pickString",
            "description": "Запрос",
            "default": "Прочитай список файлов на файловой системе и объясни о чем в них говориться?",
            "options": [
                "Прочитай список файлов на файловой системе и объясни о чем в них говориться?",
                "Как именовать таблицы в adqm? прочитай это в файлах и объясни простым языком",
                "Прочитай файл 950276.html и расскажи как именовать таблицы в adqm на основе его содержимого?",
            ]
        },
        {
            "id": "indexPath",
            "type": "promptString",
            "description": "Путь к файлу или директории для индексации",
            "default": "${workspaceFolder}/local/docs"
        },
        {
            "id": "indexCollection",
            "type": "promptString",
            "description": "Имя коллекции в ChromaDB",
            "default": "docs"
        },
        {
            "id": "indexDescription",
            "type": "promptString",
            "description": "Описание коллекции (применяется только при создании)",
            "default": "Документы, проиндексированные оператором"
        }
    ],
    "configurations": [
        {
            "name": "Agent: run query",
            "type": "debugpy",
            "request": "launch",
            "module": "boba_cli_agent_run",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--model", "${input:model}",
                "--temperature", "0.2",
                "--top-p", "0.95",
                "--presence-penalty", "0.0",
                "--frequency-penalty", "0.0",
                "${input:query}"
            ],
            "envFile": "${workspaceFolder}/local/.env",
            "env": {
                "BOBA_PROMPTS_DIR": "${workspaceFolder}/local/prompts",
                "WORKSPACE_BASE_DIR": "${workspaceFolder}/local/workspaces",
                "LOG_FILE": "${workspaceFolder}/local/logs/agent-run.log",
                "CHROMA_PERSIST_PATH": "${workspaceFolder}/local/chroma"
            }
        },
        {
            "name": "Vector Index: index path",
            "type": "debugpy",
            "request": "launch",
            "module": "boba_cli_vector_index",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "-v",
                "index",
                "${input:indexPath}",
                "--collection", "${input:indexCollection}",
                "--description", "${input:indexDescription}"
            ],
            "env": {
                "CHROMA_PERSIST_PATH": "${workspaceFolder}/local/chroma"
            }
        },
        {
            "name": "Chainlit: Boba UI",
            "type": "debugpy",
            "request": "launch",
            "module": "chainlit",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "run",
                "${workspaceFolder}/packages/boba-chainlit/src/boba_chainlit/app.py",
                "-h",
                "--host", "0.0.0.0",
                "--port", "8502",
                "--root-path", "/boba-debug"
            ],
            "envFile": "${workspaceFolder}/local/.env",
            "env": {
                "CHAINLIT_APP_ROOT": "${workspaceFolder}/packages/boba-chainlit",
                "BOBA_PROMPTS_DIR": "${workspaceFolder}/local/prompts",
                "WORKSPACE_BASE_DIR": "${workspaceFolder}/local/workspaces",
                "LOG_FILE": "${workspaceFolder}/local/logs/chainlit.log",
                "CHROMA_PERSIST_PATH": "${workspaceFolder}/local/chroma"
            }
        },
        {
            "name": "Pytest: current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "-v",
                "${file}"
            ],
            "envFile": "${workspaceFolder}/local/.env",
            "env": {
                "BOBA_PROMPTS_DIR": "${workspaceFolder}/local/prompts",
                "WORKSPACE_BASE_DIR": "${workspaceFolder}/local/workspaces",
                "LOG_FILE": "${workspaceFolder}/local/logs/tests.log"
            }
        },
    ]
}
