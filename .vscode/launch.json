{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "langgraphRagQuery",
            "type": "promptString",
            "description": "Запрос для langgraph-rag ask"
        }
    ],
    "configurations": [
        {
            "name": "Chainlit: agent",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.chainlit.agent",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Agent CLI: agent",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.agent",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "KB CLI: kb_bootstrap",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.tool.kb.cli.kb_bootstrap",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "KB CLI: kbdoc.ingest",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.tool.kb.cli.kbdoc.ingest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "KB CLI: confluence.ingest.folder",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.tool.kb.cli.confluence.ingest.folder",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "KB CLI: confluence.ingest.http",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.tool.kb.cli.confluence.ingest.http",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "KB CLI: confluence.download.http",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.tool.kb.cli.confluence.download.http",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "KB CLI: search.render",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.tool.kb.cli.search.render",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Pytest: current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "-v",
                "${file}"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Pytest: integration (current file)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "-v",
                "-rs",
                "-m",
                "integration",
                "${file}"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "LangGraph RAG: ingest",
            "type": "debugpy",
            "request": "launch",
            "module": "langgraph_rag.cli",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/experiments/langgraph-rag",
            "python": "${workspaceFolder}/experiments/langgraph-rag/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/experiments/langgraph-rag/.env",
            "args": [
                "ingest"
            ]
        },
        {
            "name": "LangGraph RAG: ingest --recreate",
            "type": "debugpy",
            "request": "launch",
            "module": "langgraph_rag.cli",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/experiments/langgraph-rag",
            "python": "${workspaceFolder}/experiments/langgraph-rag/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/experiments/langgraph-rag/.env",
            "args": [
                "ingest",
                "--recreate"
            ]
        },
        {
            "name": "LangGraph RAG: ask",
            "type": "debugpy",
            "request": "launch",
            "module": "langgraph_rag.cli",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/experiments/langgraph-rag",
            "python": "${workspaceFolder}/experiments/langgraph-rag/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/experiments/langgraph-rag/.env",
            "args": [
                "ask",
                "${input:langgraphRagQuery}"
            ]
        },
        {
            "name": "Python: current file",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "program": "${file}",
            "envFile": "${workspaceFolder}/local/.env"
        }
    ]
}
