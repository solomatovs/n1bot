{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Chainlit: agent",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.chainlit",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/.vscode",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "env": {
                "BOBA_CONFIG_PATH":"${workspaceFolder}/.vscode/local/chainlit-debug.toml",
                "CHAINLIT_APP_ROOT":"${workspaceFolder}/.vscode/local",
                "KRB5_CONFIG": "${workspaceFolder}/local/krb5.conf",
            }
        },
        {
            "name": "Chainlit2: agent",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/packages/agents/boba-chainlit2/src/boba/chainlit2/main.py",
            "console": "integratedTerminal",
            "jinja": true,
            "cwd": "${workspaceFolder}/.vscode",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "stopOnEntry": false,
            "env": {
                "BOBA_CONFIG_PATH":"${workspaceFolder}/.vscode/local/chainlit2-debug.toml",
                "CHAINLIT_APP_ROOT":"${workspaceFolder}/.vscode/local",
                "KRB5_CONFIG": "${workspaceFolder}/.vscode/local/keytab/krb5.conf",
                // клиентский keytab сервисной учётки: libkrb5 сам берёт из него TGT
                // для gssapi-подключения к postgres (kinit не нужен)
                "KRB5_CLIENT_KTNAME": "FILE:${workspaceFolder}/build/local/keytab/boba-svc.keytab",
                // отдельный ccache: иначе krb5 возьмёт тикет живого пользователя
                // из KEYRING и подключится к postgres не под boba-svc
                "KRB5CCNAME": "FILE:/tmp/krb5cc_boba_chainlit2",
            }
        },
        {
            "name": "Chainlit2: pytest current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/.vscode",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "${file}",
                "-v"
            ],
            "env": {
                "BOBA_CONFIG_PATH": "${workspaceFolder}/.vscode/local/chainlit2-debug.toml",
                "CHAINLIT_APP_ROOT": "${workspaceFolder}/.vscode/local",
                "KRB5_CONFIG": "${workspaceFolder}/.vscode/local/keytab/krb5.conf",
                "KRB5_CLIENT_KTNAME": "FILE:${workspaceFolder}/build/local/keytab/boba-svc.keytab",
                "KRB5CCNAME": "FILE:/tmp/krb5cc_boba_chainlit2"
            }
        },
        {
            "name": "Agent CLI: agent",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.agent",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/.vscode",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "env": {
                "BOBA_CONFIG_PATH":"${workspaceFolder}/.vscode/local/chainlit-debug.toml"
            }
        },
        {
            "name": "KB CLI: kb_bootstrap",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.tool.kb.cli.kb_bootstrap",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/.vscode",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "env": {
                "BOBA_CONFIG_PATH":"${workspaceFolder}/.vscode/local/chainlit-debug.toml",
                "CHAINLIT_APP_ROOT":"${workspaceFolder}/.vscode/local"
            }
        },
        {
            "name": "Python: current file",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/.vscode",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "program": "${file}"
        }
    ],
}