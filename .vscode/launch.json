{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Streamlit: app.py (port 8502)",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run", "${workspaceFolder}/src/app.py",
                "--server.port=8502",
                "--server.address=0.0.0.0",
                "--server.headless=true"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/docker",
            "envFile": "${workspaceFolder}/docker/env/.env.debug",
            "python": "${workspaceFolder}/.venv/bin/python",
            "jinja": true
        },
        {
            "name": "Test: Streaming Pipeline (загрузка)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_streaming_pipeline.py",
            "args": [
                "--space", "PAAS",
                "--max-pages", "3",
                "--batch-size", "8"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/docker",
            "envFile": "${workspaceFolder}/docker/env/.env.debug",
            "python": "${workspaceFolder}/.venv/bin/python",
            "jinja": true
        },
        {
            "name": "Test: Chat Streaming (RAG + LLM)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_chat_streaming.py",
            "args": [
                "--collection", "PAAS",
                "--query", "что такое ADQM?",
                "--model", "qwen3-0.6b"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/docker",
            "envFile": "${workspaceFolder}/docker/env/.env.debug",
            "python": "${workspaceFolder}/.venv/bin/python",
            "jinja": true
        }
    ]
}
