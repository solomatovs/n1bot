{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Chainlit: agent",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/packages/agents/boba-chainlit/src/boba/chainlit/main.py",
            "console": "integratedTerminal",
            "jinja": true,
            "cwd": "${workspaceFolder}/compose",
            "python": "${workspaceFolder}/.venv/bin/python",
            "envFile": "${workspaceFolder}/.vscode/boba-debug.env",
            "env": {
                "PATH": "${workspaceFolder}/.venv/bin:${workspaceFolder}/release/current/third/bin:${env:PATH}",
                "BOBA_BASE": "${workspaceFolder}",
                "BOBA_CONFIG_PATH": "${workspaceFolder}/compose/conf/config.toml",
                "KRB5_CONFIG": "${workspaceFolder}/compose/conf/krb/krb5.conf",
                "KRB5_CLIENT_KTNAME": "${workspaceFolder}/compose/conf/krb/krb5.keytab"
            },
            "justMyCode": false,
            "stopOnEntry": false
        },
        {
            "name": "pytest: текущий файл",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/compose",
            "python": "${workspaceFolder}/.venv/bin/python",
            "envFile": "${workspaceFolder}/.vscode/boba-debug.env",
            "env": {
                "PATH": "${workspaceFolder}/.venv/bin:${workspaceFolder}/release/current/third/bin:${env:PATH}",
                "BOBA_BASE": "${workspaceFolder}",
                "BOBA_CONFIG_PATH": "${workspaceFolder}/compose/conf/config.toml",
                "KRB5_CONFIG": "${workspaceFolder}/compose/conf/krb/krb5.conf",
                "KRB5_CLIENT_KTNAME": "${workspaceFolder}/compose/conf/krb/krb5.keytab"
            },
            "justMyCode": false,
            "args": [
                "${file}",
                "-v"
            ]
        },
        {
            "name": "pytest: все тесты",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/compose",
            "python": "${workspaceFolder}/.venv/bin/python",
            "envFile": "${workspaceFolder}/.vscode/boba-debug.env",
            "env": {
                "PATH": "${workspaceFolder}/.venv/bin:${workspaceFolder}/release/current/third/bin:${env:PATH}",
                "BOBA_BASE": "${workspaceFolder}",
                "BOBA_CONFIG_PATH": "${workspaceFolder}/compose/conf/config.toml",
                "KRB5_CONFIG": "${workspaceFolder}/compose/conf/krb/krb5.conf",
                "KRB5_CLIENT_KTNAME": "${workspaceFolder}/compose/conf/krb/krb5.keytab"
            },
            "justMyCode": false,
            "args": [
                "${workspaceFolder}/packages",
                "-q"
            ]
        },
        {
            "name": "pytest: интеграционные (живые сервисы)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/compose",
            "python": "${workspaceFolder}/.venv/bin/python",
            "envFile": "${workspaceFolder}/.vscode/boba-debug.env",
            "env": {
                "PATH": "${workspaceFolder}/.venv/bin:${workspaceFolder}/release/current/third/bin:${env:PATH}",
                "BOBA_BASE": "${workspaceFolder}",
                "BOBA_CONFIG_PATH": "${workspaceFolder}/compose/conf/config.toml",
                "KRB5_CONFIG": "${workspaceFolder}/compose/conf/krb/krb5.conf",
                "KRB5_CLIENT_KTNAME": "${workspaceFolder}/compose/conf/krb/krb5.keytab"
            },
            "justMyCode": false,
            "args": [
                "${workspaceFolder}/packages/agents/boba-chainlit/tests/test_tools_integration.py",
                "-m",
                "integration",
                "-v"
            ]
        }
    ]
}
