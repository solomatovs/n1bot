{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Agent: run query",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.agent",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            // model/query/sampling берутся из секции [cli] в local/config.toml
            // (или env-варсов BOBA_CLI__MODEL, BOBA_CLI__QUERY и т.п.).
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Index: chromadb operator ingest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            // Operator-mode прогон test_md_folder_ingest.py::test_operator_real_ingest:
            // читает [tool.chromadb] из local/config.toml — persist_path,
            // embedding_model, embedding_base_url, ingest_folder, ingest_collection.
            // `-s` нужен, чтобы тест распечатал stats (см. _emit() внутри теста).
            "args": [
                "-v",
                "-s",
                "packages/tools/boba-tool-chromadb/tests/test_md_folder_ingest.py::test_operator_real_ingest"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Chainlit: Boba UI",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.chainlit.agent",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            // ChainlitConfig читается из env (BOBA_CHAINLIT__*) или TOML [chainlit].
            // CLI-аргументы у ChainlitConfig не подключены (boba_cli=false).
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Pytest: current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "-v",
                "${file}"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Pytest: integration (current file)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "-v",
                "-rs",
                "-m",
                "integration",
                "${file}"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Python current file",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "program": "${file}"
        }
    ]
}