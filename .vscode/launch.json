{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "model",
            "type": "pickString",
            "description": "LiteLLM модель",
            "default": "qwen3.5:9b",
            "options": [
                "qwen3.5:9b",
                "qwen3.5-35b",
                "llama3.1:8b-instruct-fp16",
                "llama3.1-8b",
                "qwen2.5-14b"
            ]
        },
        {
            "id": "query",
            "type": "pickString",
            "description": "Запрос",
            "default": "Прочитай список файлов на файловой системе и объясни о чем в них говориться?",
            "options": [
                "Прочитай список файлов на файловой системе и объясни о чем в них говориться?",
                "Как именовать таблицы в adqm? прочитай это в файлах и объясни простым языком",
                "Прочитай файл 950276.html и расскажи как именовать таблицы в adqm на основе его содержимого?"
            ]
        },
        {
            "id": "indexCollection",
            "type": "promptString",
            "description": "Имя коллекции в ChromaDB",
            "default": "docs"
        },
        {
            "id": "indexDescription",
            "type": "promptString",
            "description": "Описание коллекции (применяется только при создании)",
            "default": "Документы, проиндексированные оператором"
        },
        {
            "id": "fsPaths",
            "type": "promptString",
            "description": "Путь к файлу или директории для индексации (через запятую)",
            "default": "${workspaceFolder}/local/manual"
        },
        {
            "id": "fsInclude",
            "type": "promptString",
            "description": "Glob-фильтры включения через запятую (пусто = все)",
            "default": ""
        },
        {
            "id": "confluencePageIds",
            "type": "promptString",
            "description": "Confluence page-id(s) через запятую",
            "default": "98305"
        },
        {
            "id": "confluenceSpaceKey",
            "type": "promptString",
            "description": "Confluence space key (например DOCS, paas)",
            "default": "paas"
        },
        {
            "id": "confluenceCql",
            "type": "promptString",
            "description": "Confluence CQL-запрос",
            "default": "space = paas AND type = page"
        },
        {
            "id": "showSourceId",
            "type": "promptString",
            "description": "Фильтр по source_id (пусто = все чанки коллекции)",
            "default": ""
        }
    ],
    "configurations": [
        {
            "name": "Agent: run query",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.agent_run",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--agent-run-model", "${input:model}",
                "--agent-run-temperature", "0.2",
                "--agent-run-top-p", "0.95",
                "--agent-run-presence-penalty", "0.0",
                "--agent-run-frequency-penalty", "0.0",
                "--agent-run-query", "${input:query}"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Chainlit: Boba UI",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.web.chainlit",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--chainlit-host", "0.0.0.0",
                "--chainlit-port", "8502",
                "--chainlit-root-path", "/boba-debug"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Vector Index: index FS .md (ext.fs_markdown)",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.vector_index",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--vector_index.action=index",
                "--vector_index.index.collection=${input:indexCollection}",
                "--vector_index.index.description=${input:indexDescription}",
                "--vector_index.index.pipeline=ext.fs_markdown",
                "--indexer.pipelines.fs_markdown.paths=${input:fsPaths}",
                "--indexer.pipelines.fs_markdown.include=${input:fsInclude}",
                "--vector_index.verbose=1"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Vector Index: index FS .html (ext.fs_html)",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.vector_index",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--vector_index.action=index",
                "--vector_index.index.collection=${input:indexCollection}",
                "--vector_index.index.description=${input:indexDescription}",
                "--vector_index.index.pipeline=ext.fs_html",
                "--indexer.pipelines.fs_html.paths=${input:fsPaths}",
                "--indexer.pipelines.fs_html.include=${input:fsInclude}",
                "--vector_index.verbose=1"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Vector Index: index FS .txt/.log (ext.fs_text)",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.vector_index",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--vector_index.action=index",
                "--vector_index.index.collection=${input:indexCollection}",
                "--vector_index.index.description=${input:indexDescription}",
                "--vector_index.index.pipeline=ext.fs_text",
                "--indexer.pipelines.fs_text.paths=${input:fsPaths}",
                "--indexer.pipelines.fs_text.include=${input:fsInclude}",
                "--vector_index.verbose=1"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Vector Index: index Confluence space (ext.confluence_space)",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.vector_index",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--vector_index.action=index",
                "--vector_index.index.collection=${input:indexCollection}",
                "--vector_index.index.description=${input:indexDescription}",
                "--vector_index.index.pipeline=ext.confluence_space",
                "--indexer.pipelines.confluence_space.space_key=${input:confluenceSpaceKey}",
                "--vector_index.verbose=1"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Vector Index: index Confluence pages (ext.confluence_pages)",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.vector_index",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--vector_index.action=index",
                "--vector_index.index.collection=${input:indexCollection}",
                "--vector_index.index.description=${input:indexDescription}",
                "--vector_index.index.pipeline=ext.confluence_pages",
                "--indexer.pipelines.confluence_pages.page_ids=${input:confluencePageIds}",
                "--vector_index.verbose=1"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Vector Index: index Confluence CQL (ext.confluence_cql)",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.vector_index",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--vector_index.action=index",
                "--vector_index.index.collection=${input:indexCollection}",
                "--vector_index.index.description=${input:indexDescription}",
                "--vector_index.index.pipeline=ext.confluence_cql",
                "--indexer.pipelines.confluence_cql.cql=${input:confluenceCql}",
                "--vector_index.verbose=1"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Vector Index: sync Confluence space (orphans)",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.vector_index",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--vector_index.action=sync",
                "--vector_index.sync.collection=${input:indexCollection}",
                "--vector_index.sync.pipeline=ext.confluence_space",
                "--indexer.pipelines.confluence_space.space_key=${input:confluenceSpaceKey}",
                "--vector_index.verbose=1"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Vector Index: list collections",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.vector_index",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--vector_index.action=list"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Vector Index: show collection",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.vector_index",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--vector_index.action=show",
                "--vector_index.show.collection=${input:indexCollection}",
                "--vector_index.show.source_id=${input:showSourceId}",
                "--vector_index.show.limit=20",
                "--vector_index.show.snippet_chars=200"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Vector Index: delete collection",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.vector_index",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "--vector_index.action=delete",
                "--vector_index.delete.collection=${input:indexCollection}"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Pytest: current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "-v",
                "${file}"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Pytest: all packages",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "-v",
                "${workspaceFolder}/packages"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Python current file",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "program": "${file}"
        }
    ]
}
