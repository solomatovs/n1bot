{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Chainlit: agent",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.chainlit.agent",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Agent CLI: agent",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.agent",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "KB CLI: kb_bootstrap",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.tool.kb.cli.kb_bootstrap",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "KB CLI: confluence_doc.ingest",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.tool.kb.cli.confluence_doc.ingest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "KB CLI: confluence.ingest.http",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.tool.kb.cli.confluence.ingest.http",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "KB CLI: confluence.download.http",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.tool.kb.cli.confluence.download.http",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "KB CLI: search.render",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.tool.kb.cli.search.render",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Pytest: current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "-v",
                "${file}"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Pytest: integration (current file)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "-v",
                "-rs",
                "-m",
                "integration",
                "${file}"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Python: current file",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "program": "${file}",
            "envFile": "${workspaceFolder}/local/.env"
        }
    ]
}
