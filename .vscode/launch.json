{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Chainlit: Boba UI",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.chainlit.agent",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Agent CLI: run query",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.cli.agent",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "KB CLI: bootstrap",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.tool.kb.cli.bootstrap",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "KB CLI: files_ingest",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.tool.kb.cli.files_ingest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "KB CLI: ingest_confluence_spaces",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.tool.kb.cli.ingest_confluence_spaces",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "KB CLI: confluence_space_download",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.tool.kb.cli.confluence_space_download",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "KB CLI: download_confluence_spaces",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.tool.kb.cli.download_confluence_spaces",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "KB CLI: confluence_page_download",
            "type": "debugpy",
            "request": "launch",
            "module": "boba.tool.kb.cli.confluence_page_download",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Pytest: current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "-v",
                "${file}"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Pytest: integration (current file)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "args": [
                "-v",
                "-rs",
                "-m",
                "integration",
                "${file}"
            ],
            "envFile": "${workspaceFolder}/local/.env"
        },
        {
            "name": "Python: current file",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "program": "${file}",
            "envFile": "${workspaceFolder}/local/.env"
        }
    ]
}