.venv
__pycache__
# local/ — runtime data (env, secrets, workspaces, logs, chromadb,
# prompts). В git трекаем только структуру (.gitkeep), одиночные
# шаблоны (*.example) и шаблонные директории (*.example/...).
/local/*
!/local/*.example
!/local/.gitkeep
!/local/*/
/local/*/*
!/local/*/.gitkeep
!/local/README.md
# Шаблонные директории (например local/prompts.example/) — целиком в git
!/local/*.example/
!/local/*.example/**
*.pyc
*.pyo
*.pyd
*.egg-info/
# setuptools / python -m build артефакты
packages/**/build/
packages/**/dist/
chroma_debug_db
# Chainlit runtime artifacts
.chainlit/translations/
.files/
chainlit.md
.chainlit
.ruff_cache
.pytest_cache
