.venv
__pycache__
.vscode/
*.pyc
*.pyo
*.pyd
*.egg-info/
packages/**/build/
packages/**/dist/
.ruff_cache
.pytest_cache
# chainlit на импорте создаёт эти каталоги в cwd (управляется CHAINLIT_APP_ROOT)
.chainlit/
.files/
# в build/ версионируем только сборочные исходники; артефакты (artifacts, dist,
# extract, local) не трогаем. Каталоги приходится сначала вернуть целиком —
# git не заглядывает внутрь исключённого каталога, и !/build/test/bobacheck.py
# сам по себе не сработал бы.
/build/*
!/build/docker-compose.yml
!/build/Dockerfile
!/build/Makefile
!/build/test/
/build/test/*
!/build/test/bobacheck.py
!/build/deploy/
uv.lock
