[Unit]
Description=boba-chainlit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

EnvironmentFile=${BOBA_DIR}/conf/boba.env
WorkingDirectory=${BOBA_DIR}
ExecStart=${BOBA_DIR}/third/python/bin/boba-chainlit

Restart=always
RestartSec=5
TimeoutStopSec=30

User=boba
Group=boba

## fuse-образы workspace без root: нужен /dev/fuse (модуль fuse:
## /etc/modules-load.d/fuse.conf) и userns (sysctl user.max_user_namespaces > 0)
PrivateDevices=no
RestrictNamespaces=no

[Install]
WantedBy=multi-user.target
