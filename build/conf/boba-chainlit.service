[Unit]
Description=boba-chainlit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

EnvironmentFile=${INSTALL_DIR}/conf/boba.env
WorkingDirectory=${INSTALL_DIR}/data
ExecStart=${INSTALL_DIR}/third/bin/python3 -m boba.chainlit.main

Restart=always
RestartSec=5
TimeoutStopSec=30

User=boba
Group=boba

PrivateDevices=no
RestrictNamespaces=no
PrivateUsers=no
DynamicUser=no
ProtectKernelTunables=no
Delegate=yes

[Install]
WantedBy=multi-user.target
