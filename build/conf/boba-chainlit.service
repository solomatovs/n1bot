[Unit]
Description=boba-chainlit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

EnvironmentFile=${BOBA_DIR}/conf/boba.env
WorkingDirectory=${BOBA_DIR}
ExecStart=${BOBA_DIR}/third/python/bin/boba-chainlit

Restart=always
RestartSec=5
TimeoutStopSec=30

User=boba
Group=boba

## нужен /dev/fuse что бы монтировать образы .ext4 для пользователей
## и включена поддержка userns в sysctl (sysctl user.max_user_namespaces > 0)
PrivateDevices=no
RestrictNamespaces=no

## песочница сама заворачивается в user namespace: своим userns служба его
## сделала бы вложенным, а вложенные ядро запрещает (bwrap: ENOSPC)
PrivateUsers=no
DynamicUser=no

## лаунчер образов обнуляет max_user_namespaces перед запуском чужого кода
ProtectKernelTunables=no

## групповые лимиты песочницы: cgroup_base профиля лежит внутри cgroup службы
## /sys/fs/cgroup/system.slice/boba-chainlit.service/<имя из config.toml>
Delegate=yes

[Install]
WantedBy=multi-user.target
