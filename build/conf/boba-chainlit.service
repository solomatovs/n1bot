[Unit]
Description=boba-chainlit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

EnvironmentFile=${BOBA_DIR}/conf/boba.env
WorkingDirectory=${BOBA_DIR}
ExecStart=${BOBA_DIR}/third/python/bin/boba-chainlit

Restart=always
RestartSec=5
TimeoutStopSec=30

User=boba
Group=boba

[Install]
WantedBy=multi-user.target
