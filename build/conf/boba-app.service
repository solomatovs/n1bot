[Unit]
Description=boba @APP@ (@INSTANCE@)
After=network-online.target @SANDBOX_UNIT@
@REQUIRES@

[Service]
Type=exec
Slice=boba-@INSTANCE@.slice
WorkingDirectory=@INSTALL_DIR@
ExecStart=@INSTALL_DIR@/@PROGRAM@ serve --config @INSTALL_DIR@/conf/config.toml
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=@INSTALL_DIR@/data
ProtectHome=read-only
PrivateTmp=yes
LimitNOFILE=65536
MemoryMax=@MEMORY_MAX@
MemorySwapMax=0
CPUQuota=@CPU_QUOTA@
TasksMax=@TASKS_MAX@

[Install]
WantedBy=default.target
