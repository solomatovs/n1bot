# Образец compose/<приложение>/.env: значения этой машины для docker-compose.yml.
# В compose-файлах стоят только простые подстановки ${ИМЯ} без значений по умолчанию,
# поэтому каждая переменная из этого образца должна быть в .env, пусть и пустой.
# Файл .env в git не входит; его создаёт `make -C build dev APP=<приложение>`, если
# его ещё нет, и подставляет то, что вычисляется. Остальное дописывает администратор.

# Пользователь и группа процесса в контейнере, uid:gid. Образ собран под 1000:1000:
# от этого пользователя идёт песочница, и ему же должны быть доступны тома.
BOBA_USER=1000:1000

# Каталог cgroup песочницы на хосте (только у mcp и studio): подкаталог sandbox юнита
# boba-sandbox@<приложение>.service того пользователя, чей демон docker запускает
# контейнер. В пути стоит номер пользователя (id -u).
BOBA_SANDBOX_CGROUP=/sys/fs/cgroup/user.slice/user-<uid>.slice/user@<uid>.service/boba.slice/boba-<приложение>.slice/boba-sandbox@<приложение>.service/sandbox

# Имя сети контейнера; пустым быть не может. Три приложения, прокси и базы должны
# видеть друг друга, поэтому сеть у них общая и заводится один раз:
# docker network create boba
BOBA_NETWORK=boba

# true — сеть BOBA_NETWORK уже создана снаружи, compose только подключается к ней;
# false — compose создаёт сеть сам, и принадлежит она проекту одного приложения:
# остальным приложениям подключиться к ней как к своей нельзя.
BOBA_NETWORK_EXTERNAL=true

# Закреплённый адрес контейнера в сети. Пустое значение — адрес выдаёт docker.
# Закрепляют адрес, когда по адресам контейнеров построены DNS или правила
# межсетевого экрана.
BOBA_ADDRESS=

# Закреплённый адрес второго узла (сервисы chainlit2 и mcp2; у studio переменной нет).
BOBA_ADDRESS_2=
