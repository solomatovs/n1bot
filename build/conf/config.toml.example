## единственное место, где конфиг читает окружение. BOBA_*-переменные задаются
## явно: в релизе — conf/boba.env, при запуске из IDE — .vscode/boba-debug.env
[env]
    base        = "${oc.env:BOBA_BASE}"
    app         = "${oc.env:BOBA_APP}"
    port        = "${oc.env:BOBA_PORT}"
    url_prefix  = "${oc.env:BOBA_URL_PREFIX}"
    cgroup_base = "${oc.env:BOBA_CGROUP_BASE}"

    data        = "${env.base}/data"
    sandbox     = "${env.base}/sandbox"
    krb         = "${env.base}/conf/krb"

[site]
    # ldap
    ldap_netbios        = ""
    ldap_base_dn        = ""
    ldap_url            = ""
    ldap_bind_user      = ''
    ldap_bind_password  = ""

    # krb
    krb_domain      = ""
    krb_realm       = ""
    krb_user        = ""
    krb_keytab      = "${env.krb}/krb5.keytab"
    krb_config      = "${env.krb}/krb5.conf"

    # pg
    pg_host         = ""
    pg_addr         = ""
    pg_port         = 5432
    pg_database     = ""
    pg_user         = ""
    pg_password     = ""
    pg_gssencmode   = "disable"
    pg_sslmode      = "disable"
    pg_krbsrvname   = "postgres"

    # ch
    ch_host         = ""
    ch_addr         = ""
    ch_port         = 8123
    ch_database     = "default"
    ch_user         = "default"
    ch_password     = "default"
    ch_krbsrvname   = "HTTP"

    #confluence
    confluence_url  = ""
    confluence_token= ""

    # llm inference
    llm_url         = ""
    llm_token       = ""
    llm_model       = ""
    llm_prompt      = "Ты ассистент. Отвечай по найденному контексту."

    # database encryption key (для шифрования паролей в connection таблице)
    database_encryption_key = ""
    # для шифрования сессионных токенов chainlit web server
    chainlit_auth_secret    = ""


[app]
    chainlit        = "${chainlit}"
    agent           = "${agent}"
    checkpointer    = "${checkpointer}"
    data_layer      = "${data_layer}"
    storage         = "${storage}"
    stream_journal  = "${stream_journal}"
    sandbox         = "${sandbox}"
    auth            = [
        # "${auth.kerberos}",
        "${auth.ldap}",
        "${auth.local}"
    ]

[agent]
    model                   = "${site.llm_model}"
    default_system_prompt   = "${site.llm_prompt}"
    history_messages        = 30
    [agent.openai]
        base_url            = "${site.llm_url}"
        api_key             = "${site.llm_token}"
        ssl_verify          = false
        dump                = { enable = false, path = "${env.data}/dump" }


## общий postgres: libpq-параметры подключения + пул
## (поля по https://www.postgresql.org/docs/current/libpq-connect.html)
## сервисы ([checkpointer], [data_layer]) включают его ссылкой ${postgres}
[postgres]
    host              = "${site.pg_host}"
    hostaddr          = "${site.pg_addr}"
    port              = "${site.pg_port}"
    user              = "${site.pg_user}"
    dbname            = "${site.pg_database}"
    gssencmode        = "${site.pg_gssencmode}"
    krbsrvname        = "${site.pg_krbsrvname}"
    sslmode           = "${site.pg_sslmode}"
    application_name  = "boba"
    autocommit        = true
    prepare_threshold = 0
    options           = { statement_timeout = "30s" }
    # [postgres.kerberos]
    #     keytab      = "${site.krb_keytab}"
    #     principal   = "${site.krb_user}@${site.krb_realm}"
    #     ccache      = "FILE:/tmp/krb5cc_boba_pg"
    #     krb5_config = "${site.krb_config}"
    [postgres.pool]
        timeout           = 5.0
        min_size          = 2
        max_size          = 4
        max_waiting       = 0
        max_lifetime      = 12000
        max_idle          = 600
        reconnect_timeout = 300
        num_workers       = 3


# настройка подключения к clickhouse
[clickhouse]
    host                 = "${site.ch_addr}"
    port                 = "${site.ch_port}"
    database             = "${site.ch_database}"
    username             = "${site.ch_user}"
    password             = "${site.ch_password}"
    server_host_name     = "${site.ch_host}"
    krbsrvname           = "${site.ch_krbsrvname}"
    interface            = "http"
    connect_timeout      = 10
    send_receive_timeout = 60
    query_limit          = 0
    compress             = "lz4"
    client_name          = "boba"
    settings             = { max_execution_time = 30 }
    # [clickhouse.kerberos]
    #     keytab      = "${site.krb_keytab}"
    #     principal   = "${site.krb_user}@${site.krb_realm}"
    #     ccache      = "FILE:/tmp/krb5cc_boba_ch"
    #     krb5_config = "${site.krb_config}"


# схема checkpointer (langgraph) — уходит в search_path соединения
[checkpointer]
    postgres = "${postgres}"
    schema   = "checkpoints"


# схема chainlit data layer — квалифицируется в SQL явно
[data_layer]
    postgres = "${postgres}"
    schema   = "chainlit"


# конфигурация для chainlit
## соединения в базе: профили postgres/web со скрытыми секретами
[connections]
    enable         = true
    connection     = "${postgres}"
    db_schema      = "chainlit"
    table          = "connections"
    ## 32 байта в base64; смена ключа делает сохранённые секреты нечитаемыми
    encryption_key = "${site.database_encryption_key}"


# хранилище вложений (upload файлов)
[storage]
    kind           = "image"
    image_path     = "${env.data}/workspace/{user_id}.ext4"
    image_template = "${env.sandbox}/workspace.ext4"
    op_timeout_sec = 60
    public_prefix  = "${chainlit.url_prefix}/workspace"
    binaries       = "${sandbox.binaries}"
    [storage.launcher]
        mount_wait_sec    = 10.0
        mount_poll_sec    = 0.05
        shutdown_wait_sec = 5.0
        lock_wait_sec     = 10.0
        copy_chunk_bytes  = 1048576


[stream_journal]
    enable = true
    dir    = "${env.data}/tool-logs"


[auth.kerberos]
    type                = "kerberos"
    principal_format    = "{username}@${site.krb_realm}"
    [auth.kerberos.accept]
        service_name    = "HTTP/${site.krb_domain}@${site.krb_realm}"
        keytab          = "${site.krb_keytab}"
    # маппинг ролей через ldap
    [auth.kerberos.ldap_roles]
        server          = "${site.ldap_url}"
        base_dn         = "${site.ldap_base_dn}"
        bind_dn         = "${site.ldap_bind_user}"
        bind_password   = "${site.ldap_bind_password}"
        [auth.kerberos.ldap_roles.mapping]
            member_of   = "${role.ldap.memberof}"
            dn          = "${role.ldap.dn}"


# ldap авторизация
[auth.ldap]
    type                = "ldap"
    server              = "${site.ldap_url}"
    base_dn             = "${site.ldap_base_dn}"
    user_filter         = "(sAMAccountName={username})"
    bind_dn_template    = '${site.ldap_netbios}\{username}'
    # маппинг ролей
    [auth.ldap.roles]
        member_of       = "${role.ldap.memberof}"
        dn              = "${role.ldap.dn}"

# Источник ролей пользователя из атрибутов memberOf
[role.ldap.memberof]
    "CN=boba-DEV,CN=Users,DC=example,DC=local" = ["ADM", "DEV"]
    "CN=boba-ADM,CN=Users,DC=example,DC=local" = ["ADM"]

# источник ролей пользователя из атрибутов DN
[role.ldap.dn]
    'EXAMPLE\<логин>' = ["DEV"]


# local авторизация
[auth.local]
    type          = "local"
    users         = { "<логин>" = "<пароль>" }
    roles         = { "<логин>" = ["ADM", "DEV"] }
    require_roles = true


# настройки webserver chainlit ui
[chainlit]
    host            = "0.0.0.0"
    port            = "${env.port}"
    url_prefix      = "${env.url_prefix}"
    # ssl_cert        = "${env.data}/certs/cert.crt"
    # ssl_key         = "${env.data}/certs/private.key"
    # ssl_ca_certs    = "${env.data}/certs/ca-cert.crt"
    root            = "${env.base}/app_root"
    auth_secret     = "${site.chainlit_auth_secret}"


[sandbox]
    [sandbox.binaries]
        dirs = ["${env.base}/third/bin", "/usr/bin", "/usr/sbin", "/bin", "/sbin"]

    [sandbox.bind]
        python    = "${env.sandbox}/third/python:/usr/local"
        site      = "${env.base}/deps/sandbox:/usr/local/lib/python3.11/site-packages"
        code      = "${env.app}:/usr/src"
        tessdata  = "${env.sandbox}/third/tessdata:/usr/share/tessdata"
        fastembed = "${env.sandbox}/third/fastembed:/var/cache/fastembed"
        krb       = "${env.krb}:${env.krb}"
        resolv    = "/etc/resolv.conf:/etc/resolv.conf"
        hosts     = "/etc/hosts:/etc/hosts"

    [sandbox.binds]
        core = [
            "${sandbox.bind.python}",
            "${sandbox.bind.site}",
            "${sandbox.bind.code}"
        ]
        docs = [
            "${sandbox.bind.python}",
            "${sandbox.bind.site}",
            "${sandbox.bind.code}",
            "${sandbox.bind.tessdata}"
        ]
        net  = [
            "${sandbox.bind.resolv}",
            "${sandbox.bind.hosts}",
            "${sandbox.bind.python}",
            "${sandbox.bind.site}",
            "${sandbox.bind.code}"
        ]
        pg   = [
            "${sandbox.bind.resolv}",
            "${sandbox.bind.hosts}",
            "${sandbox.bind.python}",
            "${sandbox.bind.site}",
            "${sandbox.bind.code}",
            "${sandbox.bind.krb}"
        ]
        kb   = [
            "${sandbox.bind.resolv}",
            "${sandbox.bind.hosts}",
            "${sandbox.bind.python}",
            "${sandbox.bind.site}",
            "${sandbox.bind.code}",
            "${sandbox.bind.fastembed}",
            "${sandbox.bind.tessdata}",
            "${sandbox.bind.krb}"
        ]

    ## единственный профиль; инструменты меняют его через [tool.<name>.sandbox.override]
    [sandbox.profiles.base]
        rootfs                = "${env.sandbox}/rootfs"
        ro_binds              = "${sandbox.binds.core}"
        rw_binds              = []
        rw_images             = ["${env.data}/workspace/{user_id}.ext4:/workspace"]
        image_template        = "${env.sandbox}/workspace.ext4"
        tmpfs                 = ["/tmp:512M"]
        network               = false
        timeout_sec           = 86400
        max_memory_bytes      = 1073741824
        max_cpu_sec           = 86400
        max_file_size_bytes   = 1073741824
        max_open_files        = 1024
        max_processes         = 256
        cwd                   = "/workspace"
        oom_score_adj         = 900
        cgroup_base           = "${env.cgroup_base}"
        cgroup_memory_bytes   = 1073741824
        cgroup_cpu_percent    = 100
        cgroup_cpu_weight     = 100
        cgroup_pids_max       = 256
        cgroup_swap_max_bytes = 0
        cgroup_oom_kill_all   = true
        binaries              = "${sandbox.binaries}"
        [sandbox.profiles.base.launcher]
            mount_wait_sec    = 10.0
            mount_poll_sec    = 0.05
            shutdown_wait_sec = 5.0
            lock_wait_sec     = 10.0
            copy_chunk_bytes  = 1048576
        [sandbox.profiles.base.env_set]
            HOME            = "/tmp"
            LANG            = "C.UTF-8"


[tool.bash]
    enable           = true
    roles            = ["*"]
    tools            = { bash = [] }
    max_output_bytes = 65536
    [tool.bash.sandbox]
        profile  = "${sandbox.profiles.base}"
        override = {  }

[tool.workflow]
    enable = true
    roles  = ["*"]
    tools  = { workflow = [] }

[tool.doc]
    enable                  = true
    roles                   = ["*"]
    ocr_enabled             = true
    tessdata_path           = "/usr/share/tessdata"
    max_text_chars          = 200000
    search_context_chars    = 80
    search_max_matches      = 50
    tools                   = { read_document = [], document_outline = [], search_document = [] }
    [tool.doc.sandbox]
        profile = "${sandbox.profiles.base}"
        [tool.doc.sandbox.override]
            ro_binds            = "${sandbox.binds.docs}"

[tool.chart]
    enable  = false
    roles   = ["*"]
    tools   = { visualize = [] }
    [tool.chart.sandbox]
        profile = "${sandbox.profiles.base}"
        [tool.chart.sandbox.override]
            ro_binds            = "${sandbox.binds.docs}"
            rw_images           = []
            image_template      = ""
            cwd                 = "/tmp"

[web.public]
    timeout_sec       = 30.0
    ssl_verify        = false
    retry_attempts    = 2
    retry_backoff_sec = 1.0

[web.confluence]
    base_url          = "${site.confluence_url}"
    timeout_sec       = 30.0
    ssl_verify        = false
    retry_attempts    = 3
    retry_backoff_sec = 1.0
    auth              = { method = "bearer", token = "${site.confluence_token}" }

[tool.web]
    enable          = true
    roles           = ["*"]
    max_text_chars  = 2000
    profiles        = { "<confluence.example.local>" = "${web.confluence}" }
    [tool.web.sandbox]
        profile = "${sandbox.profiles.base}"
        [tool.web.sandbox.override]
            ro_binds            = "${sandbox.binds.net}"
            rw_images           = []
            image_template      = ""
            network             = true
            cwd                 = "/tmp"
    [tool.web.tools]
        web_fetch_page = []
        web_grep_page  = []
        web_fetch      = []
        web_grep       = []

[tool.confluence]
    enable          = true
    roles           = ["*"]
    confluence      = "${web.confluence}"
    body_format     = "view"
    max_text_chars  = 2000
    [tool.confluence.sandbox]
        profile = "${sandbox.profiles.base}"
        [tool.confluence.sandbox.override]
            ro_binds            = "${sandbox.binds.net}"
            rw_images           = []
            image_template      = ""
            network             = true
            cwd                 = "/tmp"
    [tool.confluence.tools]
        confluence_search        = []
        confluence_spaces        = []
        confluence_fetch         = []
        confluence_grep          = []
        confluence_page          = []
        html_to_markdown         = []
        html_plain_text          = []
        html_confluence_sections = []

[tables.kb]
    pg_schema         = "kb"
    chunks_table      = "kb_chunks"
    collections_table = "kb_collections"

[embedding]
    model      = "intfloat/multilingual-e5-large"
    cache_dir  = "/var/cache/fastembed"
    dim        = 1024
    batch_size = 8

[tool.ingest]
    enable                 = true
    roles                  = ["*"]
    connection             = "${postgres}"
    confluence             = "${web.confluence}"
    body_format            = "view"
    collection             = "kb_confluence"
    chunk_size             = 4000
    chunk_overlap          = 0
    attachment_titles      = []
    attachment_media_types = [
        "application/pdf",
        "application/msword",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/vnd.ms-excel",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "application/vnd.ms-powerpoint",
        "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "application/vnd.oasis.opendocument.text",
        "application/vnd.oasis.opendocument.spreadsheet",
        "application/vnd.oasis.opendocument.presentation",
        "application/rtf",
        "text/rtf",
        "text/plain",
        "text/markdown",
        "text/x-markdown",
        "text/csv",
        "text/tab-separated-values",
        "image/png",
        "image/jpeg",
        "image/gif",
        "image/bmp",
        "image/webp",
        "image/tiff"
    ]
    text_encodings         = [
        "utf-8",
        "cp1251"
    ]
    tessdata_path           = "/usr/share/tessdata"
    page_workers            = 4
    embedding               = "${embedding}"
    tables                  = "${tables.kb}"
    [tool.ingest.sandbox]
        profile = "${sandbox.profiles.base}"
        [tool.ingest.sandbox.override]
            ro_binds            = "${sandbox.binds.kb}"
            rw_images           = []
            image_template      = ""
            network             = true
            cwd                 = "/tmp"
    [tool.ingest.tools]
        confluence_index_pages  = []
        confluence_index_cql    = []
        confluence_index_spaces = []
        confluence_ingest       = []
        confluence_attachment   = []


[tool.kb]
    enable     = true
    roles      = ["*"]
    connection = "${postgres}"
    embedding  = "${embedding}"
    tables     = "${tables.kb}"
    tools      = { kb_vector_search = [], kb_fts_search = [] }
    [tool.kb.sandbox]
        profile = "${sandbox.profiles.base}"
        [tool.kb.sandbox.override]
            ro_binds            = "${sandbox.binds.kb}"
            rw_images           = []
            image_template      = ""
            network             = true
            cwd                 = "/tmp"

[tool.pg]
    enable     = true
    roles      = ["*"]
    max_rows   = 500
    max_bytes  = 1000000
    profiles   = { main = "${postgres}" }
    connection = "${postgres}"
    [tool.pg.sandbox]
        profile = "${sandbox.profiles.base}"
        [tool.pg.sandbox.override]
            ro_binds            = "${sandbox.binds.pg}"
            rw_images           = []
            image_template      = ""
            network             = true
            cwd                 = "/tmp"
    [tool.pg.tools]
        pg_list_targets   = []
        pg_list_tables    = []
        pg_describe_table = []
        pg_query          = []
        pg_export         = []
        pg_copy           = []

[tool.ch]
    enable     = true
    roles      = ["*"]
    max_rows   = 100
    max_bytes  = 1000000
    profiles   = { main = "${clickhouse}" }
    [tool.ch.sandbox]
        profile = "${sandbox.profiles.base}"
        [tool.ch.sandbox.override]
            ro_binds            = "${sandbox.binds.pg}"
            rw_images           = []
            image_template      = ""
            network             = true
            cwd                 = "/tmp"
    [tool.ch.tools]
        ch_list_targets   = []
        ch_list_tables    = []
        ch_describe_table = []
        ch_query          = []
        ch_insert         = []

[tool.send_file]
    enable = true
    roles  = ["*"]
    tools  = { send_file = [] }


[tool.diagram]
    enable    = true
    roles     = ["*"]
    max_chars = 32000
    tools     = { diagram_save = [] }


[tool.canvas]
    enable = true
    roles  = ["*"]
    tools  = { canvas_open = [] }

[tool.stream_logs]
    enable = true
    roles  = ["*"]
    tools  = { stream_logs_usage = [], stream_logs_cleanup = [] }
