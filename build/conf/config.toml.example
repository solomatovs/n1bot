# Конфиг boba-chainlit для портативного релиза.
# conf/ — то, что правят руками (этот файл, промпты);
# local/ — то, что приложение пишет само (workspaces, состояние chainlit);
# third/ — программы и python, etc/ — конфиги «как в /etc» (их не трогаем).
#
# Заполнить помеченное <...>.

## LLM-провайдер (openai-совместимый API)
[openai.main]
    base_url            = "<https://llm.example.local/v1>"
    api_key             = "<ключ>"
    ssl_verify          = true
    tool_calls_fallback = true


## профиль агента
[agent.default]
    model                = "<имя модели у провайдера>"
    models               = ["<имя модели у провайдера>"]
    openai               = "${openai.main}"
    system_prompt_dir    = "${BOBA_DIR}/conf/prompts"
    user_workspace_dir   = "${BOBA_DIR}/data/workspaces/user"
    system_workspace_dir = "${BOBA_DIR}/data/workspaces/system"
    max_messages         = 30
    # сколько последних реплик истории уходит в LLM
    history_messages     = 30
    stream               = true
    log_level            = "INFO"


## само приложение
[chainlit]
    profile     = "${agent.default}"
    host        = "0.0.0.0"
    port        = 8501
    # префикс, если стоит за reverse-proxy; иначе пустая строка
    url_prefix  = ""
    # обязателен, сгенерировать: openssl rand -hex 32
    auth_secret = "<32 байта hex>"
    headless    = true
    app_root    = "${BOBA_DIR}/data/.chainlit"
    # способы входа по порядку попыток; секции ниже
    auth        = ["${auth.local}"]


## вход по таблице логин/пароль из этого файла
[auth.local]
    type          = "local"
    users         = { "<логин>" = "<пароль>" }
    roles         = "${role.local}"
    require_roles = true

[role.local]
    "<логин>" = ["ADM"]


## хранилище вложений чата: kind = "image" — внутри ext4-образа пользователя;
## kind = "local" — файлы на диске (тогда обязателен files_dir)
[storage]
    kind           = "image"
    # один образ на пользователя: общий workspace во всех его тредах;
    # путь обязан совпадать с rw_images sandbox-профиля
    image_path     = "${BOBA_DIR}/data/workspace/{user_id}.ext4"
    image_template = "${BOBA_DIR}/third/sandbox/workspace.ext4"
    op_timeout_sec = 60
    launcher       = { mount_wait_sec = 10.0, mount_poll_sec = 0.05, shutdown_wait_sec = 5.0, copy_chunk_bytes = 1048576 }
    public_prefix  = "${chainlit.url_prefix}/workspace"


## профили песочницы (bubblewrap): окружение целиком — rootfs, монтирования,
## сеть, лимиты. Все поля обязательны, лимиты строго больше нуля.
## Профиль выбирает администратор в секции инструмента, LLM о нём не знает.
[sandbox]
    ## shell пользователя: workspace-образ, python не нужен
    [sandbox.profiles.default]
        rootfs              = "${BOBA_DIR}/third/sandbox/rootfs"
        ro_binds            = ["${BOBA_DIR}/third/sandbox/python:/opt/python", "${BOBA_DIR}/third/sandbox/site:/opt/site"]
        rw_binds            = []
        rw_images           = ["${BOBA_DIR}/data/workspace/{user_id}.ext4:/workspace"]
        image_template      = "${BOBA_DIR}/third/sandbox/workspace.ext4"
        launcher            = { mount_wait_sec = 10.0, mount_poll_sec = 0.05, shutdown_wait_sec = 5.0, copy_chunk_bytes = 1048576 }
        tmpfs               = ["/tmp:512M"]
        network             = false
        env_set             = { PATH = "/opt/python/bin:/usr/local/bin:/usr/bin:/bin", PYTHONHOME = "/opt/python", PYTHONPATH = "/opt/site", LD_LIBRARY_PATH = "/opt/python/lib", HOME = "/tmp", LANG = "C.UTF-8" }
        timeout_sec         = 30
        max_memory_bytes    = 536870912
        max_cpu_sec         = 30
        max_file_size_bytes = 67108864
        max_open_files      = 1024
        max_processes       = 256
        max_output_bytes    = 262144
        cwd                 = "/workspace"
        cgroup_base         = ""
        oom_score_adj       = 500

    ## чтение документов: python и парсеры плюс образ пользователя
    [sandbox.profiles.docs]
        rootfs              = "${BOBA_DIR}/third/sandbox/rootfs"
        ro_binds            = ["${BOBA_DIR}/third/sandbox/python:/opt/python", "${BOBA_DIR}/third/sandbox/site:/opt/site", "${BOBA_DIR}/payloads/parse:/opt/payload", "${BOBA_DIR}/third/sandbox/data/tessdata:/usr/share/tessdata"]
        rw_binds            = []
        rw_images           = ["${BOBA_DIR}/data/workspace/{user_id}.ext4:/workspace"]
        image_template      = "${BOBA_DIR}/third/sandbox/workspace.ext4"
        launcher            = { mount_wait_sec = 10.0, mount_poll_sec = 0.05, shutdown_wait_sec = 5.0, copy_chunk_bytes = 1048576 }
        tmpfs               = ["/tmp:512M"]
        network             = false
        env_set             = { PATH = "/opt/python/bin:/usr/local/bin:/usr/bin:/bin", PYTHONHOME = "/opt/python", PYTHONPATH = "/opt/site", LD_LIBRARY_PATH = "/opt/python/lib", HOME = "/tmp", LANG = "C.UTF-8" }
        timeout_sec         = 120
        max_memory_bytes    = 17179869184
        max_cpu_sec         = 120
        max_file_size_bytes = 67108864
        max_open_files      = 1024
        max_processes       = 256
        max_output_bytes    = 4194304
        cwd                 = "/workspace"
        cgroup_base         = ""
        oom_score_adj       = 500

    ## разбор данных, пришедших в запросе: файловая система не нужна
    [sandbox.profiles.parser]
        rootfs              = "${BOBA_DIR}/third/sandbox/rootfs"
        ro_binds            = ["${BOBA_DIR}/third/sandbox/python:/opt/python", "${BOBA_DIR}/third/sandbox/site:/opt/site", "${BOBA_DIR}/payloads/parse:/opt/payload", "${BOBA_DIR}/third/sandbox/data/tessdata:/usr/share/tessdata"]
        rw_binds            = []
        rw_images           = []
        image_template      = ""
        launcher            = { mount_wait_sec = 10.0, mount_poll_sec = 0.05, shutdown_wait_sec = 5.0, copy_chunk_bytes = 1048576 }
        tmpfs               = ["/tmp:512M"]
        network             = false
        env_set             = { PATH = "/opt/python/bin:/usr/local/bin:/usr/bin:/bin", PYTHONHOME = "/opt/python", PYTHONPATH = "/opt/site", LD_LIBRARY_PATH = "/opt/python/lib", HOME = "/tmp", LANG = "C.UTF-8" }
        timeout_sec         = 120
        max_memory_bytes    = 17179869184
        max_cpu_sec         = 120
        max_file_size_bytes = 67108864
        max_open_files      = 1024
        max_processes       = 256
        max_output_bytes    = 16777216
        cwd                 = "/tmp"
        cgroup_base         = ""
        oom_score_adj       = 500

    ## инструменты, которые сами ходят в сеть: web и confluence
    [sandbox.profiles.network]
        rootfs              = "${BOBA_DIR}/third/sandbox/rootfs"
        ro_binds            = ["${BOBA_DIR}/third/sandbox/python:/opt/python", "${BOBA_DIR}/third/sandbox/site:/opt/site", "${BOBA_DIR}/payloads/parse:/opt/payload"]
        rw_binds            = []
        rw_images           = []
        image_template      = ""
        launcher            = { mount_wait_sec = 10.0, mount_poll_sec = 0.05, shutdown_wait_sec = 5.0, copy_chunk_bytes = 1048576 }
        tmpfs               = ["/tmp:512M"]
        network             = true
        env_set             = { PATH = "/opt/python/bin:/usr/local/bin:/usr/bin:/bin", PYTHONHOME = "/opt/python", PYTHONPATH = "/opt/site", LD_LIBRARY_PATH = "/opt/python/lib", HOME = "/tmp", LANG = "C.UTF-8" }
        timeout_sec         = 120
        max_memory_bytes    = 4294967296
        max_cpu_sec         = 120
        max_file_size_bytes = 67108864
        max_open_files      = 1024
        max_processes       = 256
        max_output_bytes    = 4194304
        cwd                 = "/tmp"
        cgroup_base         = ""
        oom_score_adj       = 500

    ## SQL к БД: сеть до постгреса, keytab и krb5.conf только на чтение
    [sandbox.profiles.pg]
        rootfs              = "${BOBA_DIR}/third/sandbox/rootfs"
        ro_binds            = ["${BOBA_DIR}/third/sandbox/python:/opt/python", "${BOBA_DIR}/third/sandbox/site:/opt/site", "${BOBA_DIR}/payloads/parse:/opt/payload", "/etc/boba/krb5.keytab:/etc/boba/krb5.keytab", "/etc/krb5.conf:/etc/krb5.conf"]
        rw_binds            = []
        rw_images           = []
        image_template      = ""
        launcher            = { mount_wait_sec = 10.0, mount_poll_sec = 0.05, shutdown_wait_sec = 5.0, copy_chunk_bytes = 1048576 }
        tmpfs               = ["/tmp:512M"]
        network             = true
        env_set             = { PATH = "/opt/python/bin:/usr/local/bin:/usr/bin:/bin", PYTHONHOME = "/opt/python", PYTHONPATH = "/opt/site", LD_LIBRARY_PATH = "/opt/python/lib", HOME = "/tmp", LANG = "C.UTF-8", KRB5_CLIENT_KTNAME = "/etc/boba/krb5.keytab", KRB5_CONFIG = "/etc/krb5.conf", KRB5CCNAME = "FILE:/tmp/krb5cc" }
        timeout_sec         = 60
        max_memory_bytes    = 1073741824
        max_cpu_sec         = 60
        max_file_size_bytes = 67108864
        max_open_files      = 256
        max_processes       = 32
        max_output_bytes    = 4194304
        cwd                 = "/tmp"
        cgroup_base         = ""
        oom_score_adj       = 500

    ## поиск по базе знаний: тот же профиль плюс веса эмбеддера
    [sandbox.profiles.kb]
        rootfs              = "${BOBA_DIR}/third/sandbox/rootfs"
        ro_binds            = ["${BOBA_DIR}/third/sandbox/python:/opt/python", "${BOBA_DIR}/third/sandbox/site:/opt/site", "${BOBA_DIR}/payloads/parse:/opt/payload", "${BOBA_DIR}/third/sandbox/data/fastembed:/opt/fastembed", "/etc/boba/krb5.keytab:/etc/boba/krb5.keytab", "/etc/krb5.conf:/etc/krb5.conf"]
        rw_binds            = []
        rw_images           = []
        image_template      = ""
        launcher            = { mount_wait_sec = 10.0, mount_poll_sec = 0.05, shutdown_wait_sec = 5.0, copy_chunk_bytes = 1048576 }
        tmpfs               = ["/tmp:512M"]
        network             = true
        env_set             = { PATH = "/opt/python/bin:/usr/local/bin:/usr/bin:/bin", PYTHONHOME = "/opt/python", PYTHONPATH = "/opt/site", LD_LIBRARY_PATH = "/opt/python/lib", HOME = "/tmp", LANG = "C.UTF-8", KRB5_CLIENT_KTNAME = "/etc/boba/krb5.keytab", KRB5_CONFIG = "/etc/krb5.conf", KRB5CCNAME = "FILE:/tmp/krb5cc" }
        timeout_sec         = 300
        max_memory_bytes    = 17179869184
        max_cpu_sec         = 300
        max_file_size_bytes = 67108864
        max_open_files      = 1024
        max_processes       = 256
        max_output_bytes    = 16777216
        cwd                 = "/tmp"
        cgroup_base         = ""
        oom_score_adj       = 500


[tool.bash]
    enable          = true
    roles           = ["ADM"]

    ## окружение запуска: профиль из [sandbox.profiles] и его переопределения
    [tool.bash.sandbox]
        profile  = "${sandbox.profiles.default}"
        override = {}

    ## доступ к tool по ролям: имя = список ролей (пусто = роли секции)
    [tool.bash.tools]
        bash = []


## чтение документов из workspace (liteparse): PDF/docx/xlsx/изображения
[tool.doc]
    enable  = true
    roles   = ["ADM"]
    ocr_enabled          = false
    ## модели OCR внутри песочницы: иначе liteparse качает их из интернета
    tessdata_path        = "/usr/share/tessdata"
    max_text_chars       = 200000
    search_context_chars = 80
    search_max_matches   = 50

    ## документы парсит payload внутри песочницы: rootfs с python и liteparse
    [tool.doc.sandbox]
        profile  = "${sandbox.profiles.docs}"
        override = {}
        entry    = ["python3", "/opt/payload/main.py"]

    [tool.doc.tools]
        read_document        = []
        read_pages           = []
        read_document_window = []
        document_outline     = []
        search_document      = []


