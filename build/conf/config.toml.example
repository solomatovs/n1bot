## единственное место, где конфиг читает окружение. BOBA_*-переменные задаются
## явно: в релизе — conf/boba.env, при запуске из IDE — .vscode/boba-debug.env.
## Ими же отдельные ветки переводятся на дерево исходников, поэтому один файл
## обслуживает и контейнер, и отладку
[env]
    runtime            = "${oc.env:BOBA_RUNTIME}"
    sandbox            = "${oc.env:BOBA_SANDBOX}"
    tools              = "${oc.env:BOBA_TOOLS}"
    assets             = "${oc.env:BOBA_ASSETS}"
    bind_code          = "${oc.env:BOBA_BIND_CODE}"
    sandbox_pythonpath = "${oc.env:BOBA_SANDBOX_PYTHONPATH}"
    cgroup_base        = "${oc.env:BOBA_CGROUP_BASE}"
    port               = "${oc.env:BOBA_PORT}"
    url_prefix         = "${oc.env:BOBA_URL_PREFIX}"
    bin                = "${oc.env:BOBA_BIN}"

    data               = "${env.runtime}/data"
    krb                = "${env.runtime}/conf/krb"

[app]
    chainlit     = "${chainlit}"
    agent        = "${agent}"
    checkpointer = "${checkpointer}"
    data_layer   = "${data_layer}"
    storage      = "${storage}"
    stream_journal = "${stream_journal}"
    sandbox      = "${sandbox}"
    auth         = [
        "${auth.local}"
    ]

[agent]
    openai                = "${openai.main}"
    model                 = "<имя модели у провайдера>"
    default_system_prompt = "Ты ассистент. Отвечай по найденному контексту."
    history_messages      = 30

[openai.main]
    base_url   = "<https://llm.example.local/v1>"
    api_key    = "<ключ>"
    ssl_verify = true
    dump       = { enable = false }

[openai.local]
    base_url   = "http://127.0.0.1:11434/v1"
    api_key    = "none"
    ssl_verify = false
    dump       = { enable = false }


## общий postgres: libpq-параметры подключения + пул
## (поля по https://www.postgresql.org/docs/current/libpq-connect.html)
## сервисы ([checkpointer], [data_layer]) включают его ссылкой ${postgres}
[postgres]
    host              = "<postgres.example.local>"
    hostaddr          = "<ip postgres>"
    port              = 5432
    user              = "<пользователь>"
    dbname            = "<база>"
    gssencmode        = "prefer"
    krbsrvname        = "postgres"
    sslmode           = "disable"
    application_name  = "boba"
    autocommit        = true
    prepare_threshold = 0
    options           = { statement_timeout = "30s" }
    [postgres.kerberos]
        keytab      = "${env.krb}/<сервисный>.keytab"
        principal   = "<пользователь>@EXAMPLE.LOCAL"
        ccache      = "FILE:/tmp/krb5cc_boba_pg"
        krb5_config = "${env.krb}/krb5.conf"
    [postgres.pool]
        timeout           = 5.0
        min_size          = 2
        max_size          = 4
        max_waiting       = 0
        max_lifetime      = 12000
        max_idle          = 600
        reconnect_timeout = 300
        num_workers       = 3


# настройка подключения к clickhouse
[clickhouse]
    host                 = "<ip clickhouse>"
    port                 = 8123
    interface            = "http"
    database             = "default"
    server_host_name     = "<ch01.example.local>"
    krbsrvname           = "HTTP"
    connect_timeout      = 10
    send_receive_timeout = 60
    query_limit          = 0
    compress             = "lz4"
    client_name          = "boba"
    settings             = { max_execution_time = 30 }
    [clickhouse.kerberos]
        keytab      = "${env.krb}/<сервисный>.keytab"
        principal   = "${postgres.kerberos.principal}"
        ccache      = "FILE:/tmp/krb5cc_boba_ch"
        krb5_config = "${env.krb}/krb5.conf"


# схема checkpointer (langgraph) — уходит в search_path соединения
[checkpointer]
    postgres = "${postgres}"
    schema   = "checkpoints"


# схема chainlit data layer — квалифицируется в SQL явно
[data_layer]
    postgres = "${postgres}"
    schema   = "chainlit"


# конфигурация для chainlit
## соединения в базе: профили postgres/web со скрытыми секретами
[connections]
    enable         = true
    connection     = "${postgres}"
    db_schema      = "chainlit"
    table          = "connections"
    ## 32 байта в base64 (openssl rand -base64 32); смена ключа делает
    ## сохранённые секреты нечитаемыми
    encryption_key = "<ключ base64>"


# хранилище вложений (upload файлов)
[storage]
    kind           = "image"
    image_path     = "${env.data}/workspace/{user_id}.ext4"
    image_template = "${env.sandbox}/workspace.ext4"
    op_timeout_sec = 60
    public_prefix  = "${chainlit.url_prefix}/workspace"
    binaries       = "${sandbox.binaries}"
    [storage.launcher]
        mount_wait_sec    = 10.0
        mount_poll_sec    = 0.05
        shutdown_wait_sec = 5.0
        lock_wait_sec     = 10.0
        copy_chunk_bytes  = 1048576


[stream_journal]
    enable = true
    dir    = "${env.data}/tool-logs"


# kerberos авторизация; подключается добавлением ${auth.kerberos} в [app].auth
[auth.kerberos]
    type                = "kerberos"
    principal_format    = "{username}@EXAMPLE.LOCAL"
    [auth.kerberos.accept]
        service_name    = 'HTTP/<boba.example.local>@EXAMPLE.LOCAL'
        keytab          = '${env.krb}/<сервисный>.keytab'
    # маппинг ролей через ldap
    [auth.kerberos.ldap_roles]
        server          = "ldaps://<dc1.example.local>:3269"
        base_dn         = "DC=example,DC=local"
        bind_dn         = "EXAMPLE\\<читающий>"
        bind_password   = "<пароль>"
        [auth.kerberos.ldap_roles.mapping]
            member_of   = "${role.ldap.memberof}"
            dn          = "${role.ldap.dn}"


# ldap авторизация; подключается добавлением ${auth.ldap} в [app].auth
[auth.ldap]
    type                = "ldap"
    server              = "ldaps://<dc1.example.local>:3269"
    base_dn             = "DC=example,DC=local"
    user_filter         = "(sAMAccountName={username})"
    bind_dn_template    = "EXAMPLE\\{username}"
    # маппинг ролей
    [auth.ldap.roles]
        member_of       = "${role.ldap.memberof}"
        dn              = "${role.ldap.dn}"

# Источник ролей пользователя из атрибутов memberOf
[role.ldap.memberof]
    "CN=boba-DEV,CN=Users,DC=example,DC=local" = ["ADM", "DEV"]
    "CN=boba-ADM,CN=Users,DC=example,DC=local" = ["ADM"]

# источник ролей пользователя из атрибутов DN
[role.ldap.dn]
    'EXAMPLE\<логин>' = ["DEV"]


# local авторизация
[auth.local]
    type          = "local"
    require_roles = true
    [auth.local.users]
        "<логин>" = "<пароль>"
    [auth.local.roles]
        "<логин>" = ["ADM", "DEV"]


# настройки webserver chainlit ui
[chainlit]
    host        = "0.0.0.0"
    port        = "${env.port}"
    url_prefix  = "${env.url_prefix}"
    # ssl_cert      = "./data/certs/cert.crt"
    # ssl_key       = "./data/certs/private.key"
    # ssl_ca_certs  = "./data/certs/ca-cert.crt"
    root        = "${env.assets}"
    auth_secret = "<32 байта hex: openssl rand -hex 32>"



[sandbox]
    [sandbox.binaries]
        dirs = ["${env.bin}", "/usr/bin", "/usr/sbin", "/bin", "/sbin"]

    [sandbox.bind]
        python    = "${env.sandbox}/third/python:/opt/python"
        ## site — третья сторона, code — код инструментов; в релизе это один
        ## и тот же собранный каталог, в IDE code уводится на дерево исходников
        site      = "${env.tools}:/opt/site"
        code      = "${env.bind_code}"
        tessdata  = "${env.sandbox}/third/tessdata:/usr/share/tessdata"
        fastembed = "${env.sandbox}/third/fastembed:/opt/fastembed"
        krb       = "${env.krb}:${env.krb}"
        resolv    = "/etc/resolv.conf:/etc/resolv.conf"
        hosts     = "/etc/hosts:/etc/hosts"

    [sandbox.binds]
        core = [
            "${sandbox.bind.python}",
            "${sandbox.bind.site}",
            "${sandbox.bind.code}"
        ]
        docs = [
            "${sandbox.bind.python}",
            "${sandbox.bind.site}",
            "${sandbox.bind.code}",
            "${sandbox.bind.tessdata}"
        ]
        net  = [
            "${sandbox.bind.resolv}",
            "${sandbox.bind.hosts}",
            "${sandbox.bind.python}",
            "${sandbox.bind.site}",
            "${sandbox.bind.code}"
        ]
        pg   = [
            "${sandbox.bind.resolv}",
            "${sandbox.bind.hosts}",
            "${sandbox.bind.python}",
            "${sandbox.bind.site}",
            "${sandbox.bind.code}",
            "${sandbox.bind.krb}"
        ]
        kb   = [
            "${sandbox.bind.resolv}",
            "${sandbox.bind.hosts}",
            "${sandbox.bind.python}",
            "${sandbox.bind.site}",
            "${sandbox.bind.code}",
            "${sandbox.bind.fastembed}",
            "${sandbox.bind.tessdata}",
            "${sandbox.bind.krb}"
        ]

    ## профиль в котором запускаются процессы tool
    ## Для конкретного иснтрумента можно  переопределять параметры через [tool.<name>.sandbox.override]
    ##
    ## rlimits: https://man7.org/linux/man-pages/man2/getrlimit.2.html
    ## max_* ставятся через prlimit(2) на процесс bwra
    ## все дерево подпроцессов (от bwrap) наследует указанные свойства
    ## 
    ## ulimit: https://man7.org/linux/man-pages/man1/ulimit.1p.html
    ## max_processes — ставит ulimit -u внутри песочницы (снаружи он ломает)
    ## создает namespace
    ## 
    ## fs: https://docs.kernel.org/admin-guide/cgroup-v2.html
    ## cgroup_* пишутся в файлы cgroup v2 каталога /sys/fs/cgroup/<name>:
    ## 
    ## runner считает (не ядро):
    ## timeout_sec      - кол-во секунд, которые работал процесс
    ##                    необязателен: без него процесс по времени не ограничен
    [sandbox.profiles.base]
        rootfs                = "${env.sandbox}/rootfs"
        ro_binds              = "${sandbox.binds.core}"
        rw_binds              = []
        rw_images             = ["${env.data}/workspace/{user_id}.ext4:/workspace"]
        image_template        = "${env.sandbox}/workspace.ext4"
        tmpfs                 = ["/tmp:512M"]
        network               = false       # false - нет сети
        timeout_sec           = 86400       # wall-clock запуска, сек; сверх — kill
        max_memory_bytes      = 536870912   # RLIMIT_AS: адресное пространство одного процесса
        max_cpu_sec           = 86400       # RLIMIT_CPU: CPU-время процесса, сек; сверх — SIGKILL
        max_file_size_bytes   = 67108864    # RLIMIT_FSIZE: размер одного создаваемого файла
        max_open_files        = 1024        # RLIMIT_NOFILE: открытых дескрипторов на процесс
        max_processes         = 256         # RLIMIT_NPROC: процессов на uid, ставится ulimit -u
        cwd                   = "/workspace"
        oom_score_adj         = 900        # 0..1000: приоритет OOM kill. чем выше, тем выше приоритет при запуске oom kill
        cgroup_base           = "${env.cgroup_base}"
        cgroup_memory_bytes   = 1073741824 # memory.max rss память на всю cgroup
        cgroup_cpu_percent    = 100        # cpu.max потолок в % одного ядра (150 — полтора)
        cgroup_cpu_weight     = 100        # cpu.weight 1..10000: доля CPU при драке за ядра между cgroup.
        # 100 по умолчанию, если 200 значит linux отдает вдвое больше времени на IO этой группы процессов.
        # когда ядра свободны, не ограничивает вовсе
        cgroup_pids_max       = 64         # pids.max: максимальное кол-во процессов внутри группы
        cgroup_swap_max_bytes = 0          # memory.swap.max: 0 — своп запрещён
        cgroup_oom_kill_all   = true       # memory.oom.group: при OOM убить всю группу процессов
        binaries              = "${sandbox.binaries}"
        ## тайминги лаунчера ext4-образов (rw_images): образ монтируется fuse2fs
        ## на время вызова, доступ к нему сериализован flock. эти же поля у
        ## [storage.launcher] — там тот же лаунчер, но для вложений
        [sandbox.profiles.base.launcher]
            mount_wait_sec    = 10.0    # сколько ждать появления монтирования в mountinfo; не успело — ошибка старта
            mount_poll_sec    = 0.05    # период опроса mountinfo в этом ожидании
            shutdown_wait_sec = 5.0     # сколько ждать штатного выхода fuse2fs после SIGTERM (он дописывает кеши); не вышел — SIGKILL, часть записей может не дойти до образа
            lock_wait_sec     = 10.0    # сколько ждать flock образа, занятого другим вызовом; вечно ждать = зависнуть
            copy_chunk_bytes  = 1048576 # блок sparse-копирования шаблона image_template при первом вызове
        [sandbox.profiles.base.env_set]
            PATH            = "/opt/python/bin:/usr/local/bin:/usr/bin:/bin"
            PYTHONHOME      = "/opt/python"
            PYTHONPATH      = "${env.sandbox_pythonpath}"
            LD_LIBRARY_PATH = "/opt/python/lib"
            HOME            = "/tmp"
            LANG            = "C.UTF-8"
            SSL_CERT_FILE   = "/etc/ssl/certs/ca-certificates.crt"


[tool.bash]
    enable = true
    roles  = ["*"]
    tools  = { bash = [] }
    [tool.bash.sandbox]
        profile  = "${sandbox.profiles.base}"
        override = {  }

[tool.doc]
    enable                  = true
    roles                   = ["*"]
    ocr_enabled             = true
    tessdata_path           = "/usr/share/tessdata"
    max_text_chars          = 200000
    search_context_chars    = 80
    search_max_matches      = 50
    tools                   = { read_document = [], document_outline = [], search_document = [] }
    [tool.doc.sandbox]
        profile = "${sandbox.profiles.base}"
        [tool.doc.sandbox.override]
            ro_binds            = "${sandbox.binds.docs}"

[tool.chart]
    enable  = false
    roles   = ["*"]
    tools   = { visualize = [] }
    [tool.chart.sandbox]
        profile = "${sandbox.profiles.base}"
        [tool.chart.sandbox.override]
            ro_binds            = "${sandbox.binds.docs}"
            rw_images           = []
            image_template      = ""
            cwd                 = "/tmp"

[web.public]
    timeout_sec       = 30.0
    ssl_verify        = false
    retry_attempts    = 2
    retry_backoff_sec = 1.0

[web.confluence]
    base_url          = "<https://confluence.example.local>"
    timeout_sec       = 30.0
    ssl_verify        = false
    retry_attempts    = 3
    retry_backoff_sec = 1.0
    auth              = { method = "bearer", token = "<токен>" }

[tool.web]
    enable          = true
    roles           = ["*"]
    max_text_chars  = 2000
    profiles        = { "<confluence.example.local>" = "${web.confluence}" }
    tools           = { web_fetch_page = [], web_grep_page = [] }
    [tool.web.sandbox]
        profile = "${sandbox.profiles.base}"
        [tool.web.sandbox.override]
            ro_binds            = "${sandbox.binds.net}"
            rw_images           = []
            image_template      = ""
            network             = true
            cwd                 = "/tmp"

[tool.confluence]
    enable          = true
    roles           = ["*"]
    confluence      = "${web.confluence}"
    body_format     = "view"
    max_text_chars  = 2000
    tools           = { confluence_search = [], confluence_spaces = [], confluence_fetch  = [], confluence_grep   = [] }
    [tool.confluence.sandbox]
        profile = "${sandbox.profiles.base}"
        [tool.confluence.sandbox.override]
            ro_binds            = "${sandbox.binds.net}"
            rw_images           = []
            image_template      = ""
            network             = true
            cwd                 = "/tmp"

[tables.kb]
    pg_schema         = "kb"
    chunks_table      = "kb_chunks"
    collections_table = "kb_collections"

[embedding]
    model      = "intfloat/multilingual-e5-large"
    cache_dir  = "/opt/fastembed"
    dim        = 1024
    batch_size = 8

[tool.ingest]
    enable                 = true
    roles                  = ["*"]
    connection             = "${postgres}"
    confluence             = "${web.confluence}"
    body_format            = "view"
    collection             = "kb_confluence"
    chunk_size             = 4000
    chunk_overlap          = 0
    attachment_titles      = []
    attachment_media_types = [
        "application/pdf",
        "application/msword",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "application/vnd.ms-excel",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "application/vnd.ms-powerpoint",
        "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "application/vnd.oasis.opendocument.text",
        "application/vnd.oasis.opendocument.spreadsheet",
        "application/vnd.oasis.opendocument.presentation",
        "application/rtf",
        "text/rtf",
        "text/plain",
        "text/markdown",
        "text/x-markdown",
        "text/csv",
        "text/tab-separated-values",
        "image/png",
        "image/jpeg",
        "image/gif",
        "image/bmp",
        "image/webp",
        "image/tiff"
    ]
    text_encodings         = [
        "utf-8",
        "cp1251"
    ]
    tessdata_path           = "/usr/share/tessdata"
    page_workers            = 4
    embedding               = "${embedding}"
    tables                  = "${tables.kb}"
    [tool.ingest.sandbox]
        profile = "${sandbox.profiles.base}"
        [tool.ingest.sandbox.override]
            ro_binds            = "${sandbox.binds.kb}"
            rw_images           = []
            image_template      = ""
            network             = true
            cwd                 = "/tmp"
    [tool.ingest.tools]
        confluence_index_pages  = []
        confluence_index_cql    = []
        confluence_index_spaces = []
        confluence_attachment   = []


[tool.kb]
    enable     = true
    roles      = ["*"]
    connection = "${postgres}"
    embedding  = "${embedding}"
    tables     = "${tables.kb}"
    tools      = { kb_vector_search = [], kb_fts_search = [] }
    [tool.kb.sandbox]
        profile = "${sandbox.profiles.base}"
        [tool.kb.sandbox.override]
            ro_binds            = "${sandbox.binds.kb}"
            rw_images           = []
            image_template      = ""
            network             = true

[tool.pg]
    enable     = true
    roles      = ["*"]
    max_rows   = 100
    max_bytes  = 1000000
    profiles   = { main = "${postgres}" }
    connection = "${postgres}"
    tools      = { pg_list_targets = [], pg_list_tables = [], pg_describe_table = [], pg_query = [], pg_export = [] }
    [tool.pg.sandbox]
        profile = "${sandbox.profiles.base}"
        [tool.pg.sandbox.override]
            ro_binds            = "${sandbox.binds.pg}"
            rw_images           = []
            image_template      = ""
            network             = true
            cwd                 = "/tmp"

[tool.ch]
    enable     = false
    roles      = ["*"]
    max_rows   = 100
    max_bytes  = 1000000
    profiles   = { main = "${clickhouse}" }
    tools      = { ch_list_targets = [], ch_list_tables = [], ch_describe_table = [], ch_query = [] }
    [tool.ch.sandbox]
        profile = "${sandbox.profiles.base}"
        [tool.ch.sandbox.override]
            ro_binds            = "${sandbox.binds.pg}"
            rw_images           = []
            image_template      = ""
            network             = true
            cwd                 = "/tmp"

[tool.send_file]
    enable = true
    roles  = ["*"]
    tools  = { send_file = [] }


[tool.diagram]
    enable    = true
    roles     = ["*"]
    max_chars = 32000
    tools     = { diagram_save = [] }


[tool.canvas]
    enable = true
    roles  = ["*"]
    tools  = { canvas_open = [] }


[tool.stream_logs]
    enable = true
    roles  = ["*"]
    tools  = { stream_logs_usage = [], stream_logs_cleanup = [] }
