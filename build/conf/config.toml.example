[paths]
    base        = "${oc.env:BOBA_BASE}"
    version     = "${oc.env:BOBA_VERSION}"
    data        = "${paths.base}/data"
    third       = "${paths.base}/third"
    sandbox     = "${paths.base}/sandbox"
    app         = "${paths.base}/app/${paths.version}"
    tools       = "${paths.app}/boba-tool"
    assets      = "${paths.app}/boba-chainlit/assets"

[app]
    chainlit    = "${chainlit}"
    agent       = "${agent}"
    checkpointer= "${checkpointer}"
    data_layer  = "${data_layer}"
    storage     = "${storage}"
    sandbox     = "${sandbox}"
    auth        = ["${auth.local}"]

[openai.main]
    base_url    = "<https://llm.example.local/v1>"
    api_key     = "<ключ>"
    ssl_verify  = true

    [openai.main.dump]
        enable  = false
        path    = "${paths.data}/dumps"

[agent]
    openai                = "${openai.main}"
    model                 = "<имя модели у провайдера>"
    default_system_prompt = "Ты ассистент. Отвечай по найденному контексту."
    history_messages      = 30

[chainlit]
    host        = "0.0.0.0"
    port        = 8501
    url_prefix  = ""
    auth_secret = "<32 байта hex: openssl rand -hex 32>"
    root        = "${paths.assets}"

[auth.local]
    type            = "local"
    users           = { "<логин>" = "<пароль>" }
    roles           = "${role.local}"
    require_roles   = true

[role.local]
    "<логин>" = ["ADM"]

[postgres]
    host                = "<хост postgres>"
    port                = 5432
    user                = "<пользователь>"
    dbname              = "<база>"
    gssencmode          = "prefer"
    sslmode             = "disable"
    application_name    = "boba"
    autocommit          = true
    pool                = { timeout = 5.0, min_size = 2, max_size = 4 }
    options             = { statement_timeout = "30s" }
    [postgres.kerberos]
        keytab          = "/etc/boba/krb5.keytab"
        principal       = "<пользователь>@EXAMPLE.LOCAL"
        ccache          = "FILE:/tmp/krb5cc_boba_pg"
        krb5_config     = "/etc/krb5.conf"

[checkpointer]
    postgres = "${postgres}"
    schema   = "checkpoints"

[data_layer]
    postgres = "${postgres}"
    schema   = "chainlit"

[connections]
    enable         = true
    connection     = "${postgres}"
    db_schema      = "chainlit"
    table          = "connections"
    encryption_key = "<ключ base64>"

[storage]
    kind           = "image"
    image_path     = "${paths.data}/workspace/{user_id}.ext4"
    image_template = "${paths.sandbox}/workspace.ext4"
    op_timeout_sec = 60
    launcher       = { mount_wait_sec = 10.0, mount_poll_sec = 0.05, shutdown_wait_sec = 5.0, copy_chunk_bytes = 1048576 }
    public_prefix  = "${chainlit.url_prefix}/workspace"

[sandbox]
    [sandbox.profiles.default]
        rootfs              = "${paths.sandbox}/rootfs"
        ro_binds            = ["${paths.sandbox}/third/python:/opt/python", "${paths.tools}:/opt/site"]
        rw_binds            = []
        rw_images           = ["${paths.data}/workspace/{user_id}.ext4:/workspace"]
        image_template      = "${paths.sandbox}/workspace.ext4"
        launcher            = { mount_wait_sec = 10.0, mount_poll_sec = 0.05, shutdown_wait_sec = 5.0, copy_chunk_bytes = 1048576 }
        tmpfs               = ["/tmp:512M"]
        network             = false
        env_set             = { PATH = "/opt/python/bin:/usr/local/bin:/usr/bin:/bin", PYTHONHOME = "/opt/python", PYTHONPATH = "/opt/site", LD_LIBRARY_PATH = "/opt/python/lib", HOME = "/tmp", LANG = "C.UTF-8" }
        timeout_sec         = 30
        max_memory_bytes    = 536870912
        max_cpu_sec         = 30
        max_file_size_bytes = 67108864
        max_open_files      = 1024
        max_processes       = 256
        max_output_bytes    = 262144
        cwd                 = "/workspace"
        cgroup_base           = "/sys/fs/cgroup/boba-sandbox"
        cgroup_memory_bytes   = 1073741824
        cgroup_cpu_percent    = 100
        cgroup_cpu_weight     = 100
        cgroup_pids_max       = 64
        cgroup_swap_max_bytes = 0
        cgroup_oom_kill_all   = true
        oom_score_adj       = 500

    [sandbox.profiles.docs]
        rootfs              = "${paths.sandbox}/rootfs"
        ro_binds            = ["${paths.sandbox}/third/python:/opt/python", "${paths.tools}:/opt/site", "${paths.sandbox}/third/tessdata:/usr/share/tessdata"]
        rw_binds            = []
        rw_images           = ["${paths.data}/workspace/{user_id}.ext4:/workspace"]
        image_template      = "${paths.sandbox}/workspace.ext4"
        launcher            = { mount_wait_sec = 10.0, mount_poll_sec = 0.05, shutdown_wait_sec = 5.0, copy_chunk_bytes = 1048576 }
        tmpfs               = ["/tmp:512M"]
        network             = false
        env_set             = { PATH = "/opt/python/bin:/usr/local/bin:/usr/bin:/bin", PYTHONHOME = "/opt/python", PYTHONPATH = "/opt/site", LD_LIBRARY_PATH = "/opt/python/lib", HOME = "/tmp", LANG = "C.UTF-8" }
        timeout_sec         = 120
        max_memory_bytes    = 17179869184
        max_cpu_sec         = 120
        max_file_size_bytes = 67108864
        max_open_files      = 1024
        max_processes       = 256
        max_output_bytes    = 4194304
        cwd                 = "/workspace"
        cgroup_base           = "/sys/fs/cgroup/boba-sandbox"
        cgroup_memory_bytes   = 4294967296
        cgroup_cpu_percent    = 200
        cgroup_cpu_weight     = 100
        cgroup_pids_max       = 256
        cgroup_swap_max_bytes = 0
        cgroup_oom_kill_all   = true
        oom_score_adj       = 500

    [sandbox.profiles.parser]
        rootfs              = "${paths.sandbox}/rootfs"
        ro_binds            = ["${paths.sandbox}/third/python:/opt/python", "${paths.tools}:/opt/site", "${paths.sandbox}/third/tessdata:/usr/share/tessdata"]
        rw_binds            = []
        rw_images           = []
        image_template      = ""
        launcher            = { mount_wait_sec = 10.0, mount_poll_sec = 0.05, shutdown_wait_sec = 5.0, copy_chunk_bytes = 1048576 }
        tmpfs               = ["/tmp:512M"]
        network             = false
        env_set             = { PATH = "/opt/python/bin:/usr/local/bin:/usr/bin:/bin", PYTHONHOME = "/opt/python", PYTHONPATH = "/opt/site", LD_LIBRARY_PATH = "/opt/python/lib", HOME = "/tmp", LANG = "C.UTF-8" }
        timeout_sec         = 120
        max_memory_bytes    = 17179869184
        max_cpu_sec         = 120
        max_file_size_bytes = 67108864
        max_open_files      = 1024
        max_processes       = 256
        max_output_bytes    = 16777216
        cwd                 = "/tmp"
        cgroup_base           = "/sys/fs/cgroup/boba-sandbox"
        cgroup_memory_bytes   = 4294967296
        cgroup_cpu_percent    = 200
        cgroup_cpu_weight     = 100
        cgroup_pids_max       = 256
        cgroup_swap_max_bytes = 0
        cgroup_oom_kill_all   = true
        oom_score_adj       = 500

    [sandbox.profiles.network]
        rootfs              = "${paths.sandbox}/rootfs"
        ro_binds            = ["/etc/resolv.conf:/etc/resolv.conf", "/etc/hosts:/etc/hosts", "${paths.sandbox}/third/python:/opt/python", "${paths.tools}:/opt/site"]
        rw_binds            = []
        rw_images           = []
        image_template      = ""
        launcher            = { mount_wait_sec = 10.0, mount_poll_sec = 0.05, shutdown_wait_sec = 5.0, copy_chunk_bytes = 1048576 }
        tmpfs               = ["/tmp:512M"]
        network             = true
        env_set             = { PATH = "/opt/python/bin:/usr/local/bin:/usr/bin:/bin", PYTHONHOME = "/opt/python", PYTHONPATH = "/opt/site", LD_LIBRARY_PATH = "/opt/python/lib", HOME = "/tmp", LANG = "C.UTF-8", SSL_CERT_FILE = "/etc/ssl/certs/ca-certificates.crt" }
        timeout_sec         = 120
        max_memory_bytes    = 4294967296
        max_cpu_sec         = 120
        max_file_size_bytes = 67108864
        max_open_files      = 1024
        max_processes       = 256
        max_output_bytes    = 4194304
        cwd                 = "/tmp"
        cgroup_base           = "/sys/fs/cgroup/boba-sandbox"
        cgroup_memory_bytes   = 2147483648
        cgroup_cpu_percent    = 100
        cgroup_cpu_weight     = 100
        cgroup_pids_max       = 64
        cgroup_swap_max_bytes = 0
        cgroup_oom_kill_all   = true
        oom_score_adj       = 500

    [sandbox.profiles.pg]
        rootfs              = "${paths.sandbox}/rootfs"
        ro_binds            = ["/etc/resolv.conf:/etc/resolv.conf", "/etc/hosts:/etc/hosts", "${paths.sandbox}/third/python:/opt/python", "${paths.tools}:/opt/site", "/etc/boba/krb5.keytab:/etc/boba/krb5.keytab", "/etc/krb5.conf:/etc/krb5.conf"]
        rw_binds            = []
        rw_images           = []
        image_template      = ""
        launcher            = { mount_wait_sec = 10.0, mount_poll_sec = 0.05, shutdown_wait_sec = 5.0, copy_chunk_bytes = 1048576 }
        tmpfs               = ["/tmp:512M"]
        network             = true
        env_set             = { PATH = "/opt/python/bin:/usr/local/bin:/usr/bin:/bin", PYTHONHOME = "/opt/python", PYTHONPATH = "/opt/site", LD_LIBRARY_PATH = "/opt/python/lib", HOME = "/tmp", LANG = "C.UTF-8" }
        timeout_sec         = 60
        max_memory_bytes    = 1073741824
        max_cpu_sec         = 60
        max_file_size_bytes = 67108864
        max_open_files      = 256
        max_processes       = 32
        max_output_bytes    = 4194304
        cwd                 = "/tmp"
        cgroup_base           = "/sys/fs/cgroup/boba-sandbox"
        cgroup_memory_bytes   = 1073741824
        cgroup_cpu_percent    = 100
        cgroup_cpu_weight     = 100
        cgroup_pids_max       = 32
        cgroup_swap_max_bytes = 0
        cgroup_oom_kill_all   = true
        oom_score_adj       = 500

    [sandbox.profiles.kb]
        rootfs              = "${paths.sandbox}/rootfs"
        ro_binds            = ["/etc/resolv.conf:/etc/resolv.conf", "/etc/hosts:/etc/hosts", "${paths.sandbox}/third/python:/opt/python", "${paths.tools}:/opt/site", "${paths.sandbox}/third/fastembed:/opt/fastembed", "${paths.sandbox}/third/tessdata:/usr/share/tessdata", "/etc/boba/krb5.keytab:/etc/boba/krb5.keytab", "/etc/krb5.conf:/etc/krb5.conf"]
        rw_binds            = []
        rw_images           = []
        image_template      = ""
        launcher            = { mount_wait_sec = 10.0, mount_poll_sec = 0.05, shutdown_wait_sec = 5.0, copy_chunk_bytes = 1048576 }
        tmpfs               = ["/tmp:512M"]
        network             = true
        env_set             = { PATH = "/opt/python/bin:/usr/local/bin:/usr/bin:/bin", PYTHONHOME = "/opt/python", PYTHONPATH = "/opt/site", LD_LIBRARY_PATH = "/opt/python/lib", HOME = "/tmp", LANG = "C.UTF-8", SSL_CERT_FILE = "/etc/ssl/certs/ca-certificates.crt" }
        timeout_sec         = 300
        max_memory_bytes    = 17179869184
        max_cpu_sec         = 300
        max_file_size_bytes = 67108864
        max_open_files      = 1024
        max_processes       = 256
        max_output_bytes    = 16777216
        cwd                 = "/tmp"
        cgroup_base           = "/sys/fs/cgroup/boba-sandbox"
        cgroup_memory_bytes   = 8589934592
        cgroup_cpu_percent    = 400
        cgroup_cpu_weight     = 100
        cgroup_pids_max       = 256
        cgroup_swap_max_bytes = 0
        cgroup_oom_kill_all   = true
        oom_score_adj       = 500

[tool.bash]
    enable = true
    roles  = ["ADM"]

    [tool.bash.sandbox]
        profile  = "${sandbox.profiles.default}"
        override = {}

    [tool.bash.tools]
        bash = []

[tool.doc]
    enable               = true
    roles                = ["ADM"]
    ocr_enabled          = false
    tessdata_path        = "/usr/share/tessdata"
    max_text_chars       = 200000
    search_context_chars = 80
    search_max_matches   = 50

    [tool.doc.sandbox]
        profile  = "${sandbox.profiles.docs}"
        override = {}

    [tool.doc.tools]
        read_document        = []
        document_outline     = []
        search_document      = []

[tool.chart]
    enable = true
    roles  = ["*"]

    [tool.chart.sandbox]
        profile  = "${sandbox.profiles.parser}"
        override = {}

    [tool.chart.tools]
        visualize = []

[tool.web]
    enable         = true
    roles          = ["ADM"]
    max_text_chars = 2000
    profiles       = { "<hostname>" = "${web.public}" }

    [tool.web.sandbox]
        profile  = "${sandbox.profiles.network}"
        override = {}

    [tool.web.tools]
        web_fetch_page = []
        web_grep_page  = []

[web.public]
    kind              = "web"
    timeout_sec       = 30.0
    ssl_verify        = true
    retry_attempts    = 3
    retry_backoff_sec = 1.0
    auth              = { method = "none" }

[web.confluence]
    kind              = "web"
    base_url          = "<https://confluence.example.local>"
    timeout_sec       = 30.0
    ssl_verify        = true
    retry_attempts    = 3
    retry_backoff_sec = 1.0
    auth              = { method = "bearer", token = "<токен>" }

[tool.confluence]
    enable         = true
    roles          = ["ADM"]
    confluence     = "${web.confluence}"
    body_format    = "view"
    max_text_chars = 2000

    [tool.confluence.sandbox]
        profile  = "${sandbox.profiles.network}"
        override = {}

    [tool.confluence.tools]
        confluence_fetch  = []
        confluence_grep   = []
        confluence_search = []
        confluence_spaces = []

[tool.ingest]
    enable            = true
    roles             = ["ADM"]
    connection        = "${postgres}"
    tables            = "${kb.tables}"
    embedding         = "${embedding.e5}"
    confluence        = "${web.confluence}"
    body_format       = "view"
    collection        = "kb_confluence"
    chunk_size        = 4000
    chunk_overlap     = 0
    attachment_titles = ["*.pdf", "*.docx", "*.xlsx"]
    tessdata_path     = "/usr/share/tessdata"
    page_workers      = 4

    [tool.ingest.sandbox]
        profile  = "${sandbox.profiles.kb}"
        override = { timeout_sec = 3600, max_cpu_sec = 14400 }

    [tool.ingest.tools]
        confluence_index_pages  = []
        confluence_index_cql    = []
        confluence_index_spaces = []
        confluence_attachment   = []

[tool.pg]
    enable    = true
    roles     = ["ADM"]
    max_rows  = 100
    max_bytes = 1000000
    profiles  = { main = "${postgres}" }

    [tool.pg.sandbox]
        profile  = "${sandbox.profiles.pg}"
        override = {}

    [tool.pg.tools]
        pg_list_targets   = []
        pg_list_tables    = []
        pg_describe_table = []
        pg_query          = []
        pg_export         = []

[tool.kb]
    enable     = true
    roles      = ["ADM"]
    connection = "${postgres}"
    tables     = "${kb.tables}"
    embedding  = "${embedding.e5}"

    [tool.kb.sandbox]
        profile  = "${sandbox.profiles.kb}"
        override = {}

    [tool.kb.tools]
        kb_vector_search = []
        kb_fts_search    = []

[kb.tables]
    pg_schema         = "kb"
    chunks_table      = "kb_chunks"
    collections_table = "kb_collections"

[embedding.e5]
    model     = "intfloat/multilingual-e5-large"
    cache_dir = "/opt/fastembed"
    dim       = 1024
    batch_size = 8

