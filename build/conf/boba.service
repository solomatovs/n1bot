[Unit]
Description=boba-${BOBA_APP}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

EnvironmentFile=${INSTALL_DIR}/conf/boba.env
WorkingDirectory=${BOBA_DATA}
ExecStartPre=/bin/mkdir -p ${BOBA_DATA}/dump
ExecStart=${INSTALL_DIR}/third/bin/python3 -m ${BOBA_MODULE} --config ${INSTALL_DIR}/conf/config.toml

Restart=always
RestartSec=5
TimeoutStopSec=30

User=boba
Group=boba

DynamicUser=no

[Install]
WantedBy=multi-user.target
