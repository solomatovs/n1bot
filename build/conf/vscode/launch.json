{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Aid: chat",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/debug/aid",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "stopOnEntry": false,
            "subProcess": true,
            "preLaunchTask": "aid: debug tree",
            "program": "${workspaceFolder}/packages/apps/boba-aid/src/boba/aid/main.py",
            "jinja": true,
            "args": [
                "--config",
                "${workspaceFolder}/packages/apps/boba-aid/conf/config.toml",
                "--site",
                "${workspaceFolder}/debug/aid/conf/site.toml"
            ],
            "env": {
                "PATH": "${workspaceFolder}/.venv/bin:${workspaceFolder}/runtime/third/bin:${env:PATH}",
                "LD_LIBRARY_PATH": "${workspaceFolder}/runtime/third/lib",
                "BOBA_AGENT_MODE": "${input:agentMode}"
            }
        },
        {
            "name": "MCP: tools service",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/debug/mcp",
            "python": "${workspaceFolder}/.vscode/python-debug-slice.sh",
            "justMyCode": false,
            "stopOnEntry": false,
            "subProcess": true,
            "module": "boba.mcp_server",
            "args": [
                "--config",
                "${workspaceFolder}/packages/apps/boba-mcp/conf/config.toml",
                "--site",
                "${workspaceFolder}/debug/mcp/conf/site.toml"
            ],
            "env": {
                "PATH": "${workspaceFolder}/.venv/bin:${workspaceFolder}/runtime/third/bin:${env:PATH}",
                "LD_LIBRARY_PATH": "${workspaceFolder}/runtime/third/lib",
                "BOBA_TOOL_LAUNCHER": "${input:toolLauncher}"
            }
        },
        {
            "name": "Boba: agent service",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/debug/boba",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "stopOnEntry": false,
            "subProcess": true,
            "module": "boba.cli.app",
            "args": [
                "serve",
                "--config",
                "${workspaceFolder}/packages/apps/boba-cli/conf/config.toml",
                "--site",
                "${workspaceFolder}/debug/boba/conf/site.toml"
            ],
            "env": {
                "PATH": "${workspaceFolder}/.venv/bin:${workspaceFolder}/runtime/third/bin:${env:PATH}",
                "LD_LIBRARY_PATH": "${workspaceFolder}/runtime/third/lib"
            }
        },
        {
            "name": "tool",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/debug/mcp",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "stopOnEntry": false,
            "module": "boba.runtime.toolcli",
            "args": "${input:toolCall} --config ${workspaceFolder}/packages/apps/boba-mcp/conf/config.toml --site ${workspaceFolder}/debug/mcp/conf/site.toml --injected ${workspaceFolder}/.vscode/injected/${input:toolInjected}.json",
            "env": {
                "PATH": "${workspaceFolder}/.venv/bin:${workspaceFolder}/runtime/third/bin:${env:PATH}",
                "LD_LIBRARY_PATH": "${workspaceFolder}/runtime/third/lib",
                "BOBA_LOG_LEVEL": "DEBUG"
            }
        },
        {
            "name": "ix-fts",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/debug/ix-fts",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "stopOnEntry": false,
            "subProcess": true,
            "program": "${workspaceFolder}/packages/apps/ix/ix-fts/src/boba/ix_fts/worker.py",
            "args": [
                "run",
                "--config",
                "${workspaceFolder}/debug/ix-fts/conf.toml"
            ]
        },
        {
            "name": "pg-meta-scraper",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/debug/pg-meta-scraper",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "stopOnEntry": false,
            "subProcess": true,
            "program": "${workspaceFolder}/packages/apps/ix/pg-meta-scraper/src/boba/pg_meta_scraper/worker.py",
            "args": [
                "run",
                "--config",
                "${workspaceFolder}/debug/pg-meta-scraper/conf.toml"
            ]
        },
        {
            "name": "ch-meta-scraper",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/debug/ch-meta-scraper",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "stopOnEntry": false,
            "subProcess": true,
            "program": "${workspaceFolder}/packages/apps/ix/ch-meta-scraper/src/boba/ch_meta_scraper/worker.py",
            "args": [
                "run",
                "--config",
                "${workspaceFolder}/debug/ch-meta-scraper/conf.toml"
            ]
        },
        {
            "name": "cfl-indexer",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/debug/cfl-indexer",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "stopOnEntry": false,
            "subProcess": true,
            "program": "${workspaceFolder}/packages/apps/ix/cfl-indexer/src/boba/cfl_indexer/worker.py",
            "args": [
                "run",
                "--config",
                "${workspaceFolder}/debug/cfl-indexer/conf.toml"
            ]
        },
        {
            "name": "ix-search-lab",
            "type": "debugpy",
            "request": "launch",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/debug/ix-search-lab",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false,
            "stopOnEntry": false,
            "subProcess": true,
            "program": "${workspaceFolder}/packages/apps/ix/ix-search-lab/src/boba/ix_search_lab/server.py",
            "args": [
                "--config",
                "${workspaceFolder}/debug/ix-search-lab/conf.toml"
            ]
        },
        {
            "name": "pytest: текущий файл",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/debug/aid",
            "python": "${workspaceFolder}/.vscode/python-debug-slice.sh",
            "env": {
                "PATH": "${workspaceFolder}/.venv/bin:${workspaceFolder}/runtime/third/bin:${env:PATH}",
                "LD_LIBRARY_PATH": "${workspaceFolder}/runtime/third/lib",
                "BOBA_CONFIG_PATH": "${workspaceFolder}/packages/apps/boba-aid/conf/config.toml",
                "BOBA_SITE_PATH": "${workspaceFolder}/debug/aid/conf/site.toml",
                "BOBA_CGROUP_BASE": "@DEBUG_CGROUP@"
            },
            "justMyCode": false,
            "args": [
                "${file}",
                "-m",
                "integration or not integration",
                "-v"
            ]
        },
        {
            "name": "pytest: выделенное (-k) в текущем файле",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/debug/aid",
            "python": "${workspaceFolder}/.vscode/python-debug-slice.sh",
            "env": {
                "PATH": "${workspaceFolder}/.venv/bin:${workspaceFolder}/runtime/third/bin:${env:PATH}",
                "LD_LIBRARY_PATH": "${workspaceFolder}/runtime/third/lib",
                "BOBA_CONFIG_PATH": "${workspaceFolder}/packages/apps/boba-aid/conf/config.toml",
                "BOBA_SITE_PATH": "${workspaceFolder}/debug/aid/conf/site.toml",
                "BOBA_CGROUP_BASE": "@DEBUG_CGROUP@"
            },
            "justMyCode": false,
            "args": [
                "${file}",
                "-m",
                "integration or not integration",
                "-v",
                "-s",
                "-k",
                "${selectedText}"
            ]
        },
        {
            "name": "pytest: все тесты",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/debug/aid",
            "python": "${workspaceFolder}/.vscode/python-debug-slice.sh",
            "env": {
                "PATH": "${workspaceFolder}/.venv/bin:${workspaceFolder}/runtime/third/bin:${env:PATH}",
                "LD_LIBRARY_PATH": "${workspaceFolder}/runtime/third/lib",
                "BOBA_CONFIG_PATH": "${workspaceFolder}/packages/apps/boba-aid/conf/config.toml",
                "BOBA_SITE_PATH": "${workspaceFolder}/debug/aid/conf/site.toml",
                "BOBA_CGROUP_BASE": "@DEBUG_CGROUP@"
            },
            "justMyCode": false,
            "args": [
                "${workspaceFolder}/packages",
                "-q"
            ]
        },
        {
            "name": "pytest: интеграционные (живые сервисы, стенд + браузер)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/debug/aid",
            "python": "${workspaceFolder}/.vscode/python-debug-slice.sh",
            "env": {
                "PATH": "${workspaceFolder}/.venv/bin:${workspaceFolder}/runtime/third/bin:${env:PATH}",
                "LD_LIBRARY_PATH": "${workspaceFolder}/runtime/third/lib",
                "BOBA_CONFIG_PATH": "${workspaceFolder}/packages/apps/boba-aid/conf/config.toml",
                "BOBA_SITE_PATH": "${workspaceFolder}/debug/aid/conf/site.toml",
                "BOBA_CGROUP_BASE": "@DEBUG_CGROUP@"
            },
            "justMyCode": false,
            "args": [
                "${workspaceFolder}/packages",
                "-m",
                "integration or ui",
                "-v"
            ]
        }
    ],
    "compounds": [
        {
            "name": "Aid: aid + mcp + boba",
            "configurations": [
                "Aid: chat",
                "MCP: tools service",
                "Boba: agent service"
            ],
            "stopAll": true
        }
    ],
    "inputs": [
        {
            "id": "agentMode",
            "type": "pickString",
            "description": "Agent of the chat: process runs boba --stdio as a child under the debugger, service calls the Boba: agent service target",
            "options": [
                "process",
                "service"
            ],
            "default": "process"
        },
        {
            "id": "toolLauncher",
            "type": "pickString",
            "description": "Tool bodies of boba-mcp: process runs them as children under the debugger, sandbox runs them in bwrap as in the container",
            "options": [
                "process",
                "sandbox"
            ],
            "default": "process"
        },
        {
            "id": "toolCall",
            "type": "promptString",
            "description": "Tool module, tool name and its flags",
            "default": "boba.tool.pg.tools pg_query --sql \"select 1\" --offset 0 --limit 10"
        },
        {
            "id": "toolInjected",
            "type": "promptString",
            "description": "Call config of the tool: file name in .vscode/injected without .json",
            "default": "pg"
        }
    ]
}
