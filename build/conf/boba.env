BOBA_BASE=${BOBA_BASE}
BOBA_APP=${BOBA_BASE}/code/sandbox
BOBA_PORT=8501
BOBA_URL_PREFIX=/boba
BOBA_CGROUP_BASE=/sys/fs/cgroup/boba.slice/boba-sandbox

HOME=${BOBA_BASE}/data

PATH=${BOBA_BASE}/code/app/bin:${BOBA_BASE}/third/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PYTHONHOME=${BOBA_BASE}/third
PYTHONPATH=${BOBA_BASE}/code/app:${BOBA_BASE}/deps/app
PYTHONNOUSERSITE=1
LD_LIBRARY_PATH=${BOBA_BASE}/third/lib

LANG=C.UTF-8
LC_ALL=C.UTF-8
