BOBA_BASE=${BOBA_BASE}
BOBA_VERSION=${BOBA_VERSION}

BOBA_CONFIG_PATH=${BOBA_BASE}/conf/config.toml
BOBA_RUNTIME=${BOBA_BASE}
BOBA_SANDBOX=${BOBA_BASE}/sandbox
BOBA_TOOLS=${BOBA_BASE}/app/${BOBA_VERSION}/boba-tool
BOBA_ASSETS=${BOBA_BASE}/app/${BOBA_VERSION}/boba-chainlit/assets
BOBA_BIND_CODE=${BOBA_BASE}/app/${BOBA_VERSION}/boba-tool:/opt/site
BOBA_SANDBOX_PYTHONPATH=/opt/site
BOBA_CGROUP_BASE=/sys/fs/cgroup/boba.slice/boba-sandbox
BOBA_PORT=8501
BOBA_URL_PREFIX=/boba

HOME=${BOBA_BASE}/data

PYTHONHOME=${BOBA_BASE}/third
PYTHONPATH=${BOBA_BASE}/app/${BOBA_VERSION}/boba-chainlit
PYTHONNOUSERSITE=1

PATH=${BOBA_BASE}/app/${BOBA_VERSION}/boba-chainlit/bin:${BOBA_BASE}/third/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LD_LIBRARY_PATH=${BOBA_BASE}/third/lib

LANG=C.UTF-8
LC_ALL=C.UTF-8
