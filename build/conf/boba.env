HOME=${BOBA_DIR}/data/home

TESSDATA_PREFIX=${BOBA_DIR}/third/tessdata
TESSDATA_PATH=${BOBA_DIR}/third/tessdata
FASTEMBED_CACHE_PATH=${BOBA_DIR}/third/fastembed
MAGICK_CONFIGURE_PATH=${BOBA_DIR}/etc/ImageMagick-6

BOBA_CONFIG_PATH=${BOBA_DIR}/conf/config.toml
CHAINLIT_APP_ROOT=${BOBA_DIR}/data/.chainlit

PYTHONHOME=${BOBA_DIR}/third/python
PYTHONPATH=${BOBA_DIR}/third/python/lib/python${PYTHON_VERSION}/site-packages
PYTHONNOUSERSITE=1

PATH=${BOBA_DIR}/third/python/bin:${BOBA_DIR}/third/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LD_LIBRARY_PATH=${BOBA_DIR}/third/lib:${BOBA_DIR}/third/python/lib

LANG=C.UTF-8
LC_ALL=C.UTF-8
