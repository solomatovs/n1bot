BOBA_BASE=${BOBA_BASE}
BOBA_DATA=${BOBA_DATA}
# дерево живого кода инструментов: есть только в отладке, в релизе его нет —
# бинд просто пропускается, код приезжает из образа песочницы
BOBA_APP=${BOBA_BASE}/src
BOBA_PORT=8501
BOBA_INSTANCE_ID=node1
BOBA_URL_PREFIX=/boba
BOBA_CGROUP_BASE=/sys/fs/cgroup/boba.slice/boba-sandbox

HOME=${BOBA_DATA}
# libkrb5 читает конфиг из окружения: системный /etc/krb5.conf может быть
# чужим (в образе лежит дефолтный MIT с realm ATHENA.MIT.EDU)
KRB5_CONFIG=${BOBA_BASE}/conf/krb/krb5.conf

PATH=${BOBA_BASE}/app/bin:${BOBA_BASE}/third/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PYTHONHOME=${BOBA_BASE}/third
PYTHONPATH=${BOBA_BASE}/app
PYTHONNOUSERSITE=1
LD_LIBRARY_PATH=${BOBA_BASE}/third/lib

LANG=C.UTF-8
LC_ALL=C.UTF-8

