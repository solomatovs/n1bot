[Unit]
Description=boba-chainlit (release __RELEASE_NAME__)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# все пути (PYTHONHOME, конфиг, веса) — в boba.env
EnvironmentFile=__INSTALL_DIR__/boba.env
WorkingDirectory=__INSTALL_DIR__
ExecStart=__INSTALL_DIR__/python/bin/python3 -m boba.chainlit

Restart=always
RestartSec=5
TimeoutStopSec=30

# под непривилегированным пользователем: ему нужен доступ на запись в local/
# User=boba
# Group=boba

[Install]
WantedBy=multi-user.target
