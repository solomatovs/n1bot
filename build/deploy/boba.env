PYTHONHOME=__INSTALL_DIR__/python
PATH=__INSTALL_DIR__/python/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LD_LIBRARY_PATH=__INSTALL_DIR__/lib:__INSTALL_DIR__/python/lib

PYTHONNOUSERSITE=1

TESSDATA_PREFIX=__INSTALL_DIR__/opt/tessdata
TESSDATA_PATH=__INSTALL_DIR__/opt/tessdata
FASTEMBED_CACHE_PATH=__INSTALL_DIR__/opt/fastembed

# конфигурация (правится руками)
BOBA_CONFIG_PATH=__INSTALL_DIR__/conf/config.toml
# рабочий каталог (пишет приложение)
CHAINLIT_APP_ROOT=__INSTALL_DIR__/local

# сертификаты
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

LANG=C.UTF-8

# путь к keytab указывается в config.toml; krb5.conf берётся системный
# KRB5_CONFIG=/etc/krb5.conf
