# Опциональный override-слой (BOBA_SECRETS_PATH), мержится ПОВЕРХ config.toml.
# По умолчанию НЕ нужен: подключения и секреты живут прямо в config.toml.
# Используй только если хочешь держать секреты вне основного файла —
# тогда продублируй сюда нужные ветки (пути совпадают с config.toml):
#
# [openai.openrouter]
# api_key = "sk-or-v1-..."
#
# [postgres.main]
# password = "..."
#
# [chainlit]
# auth_secret = "..."
