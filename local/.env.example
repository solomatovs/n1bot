# Шаблон секретов и tunables для локального запуска и docker-compose.
# Скопировать в ``local/.env`` и заполнить реальными значениями. Сам
# .env gitignored (см. .gitignore: ``/local/*``); трекается только этот
# .env.example.
#
# Используется в двух местах:
#  - VS Code launch.json: ``envFile: ${workspaceFolder}/local/.env``
#  - docker-compose.yml:  ``env_file: ./local/.env``
#
# Имена ключей задаются единым алгоритмом в boba-config-env:
#   ConfigKey(parts...) -> "BOBA_" + "_".join(parts).upper()
# (см. packages/boba-config-env/src/boba_config_env/_source.py).
# Альтернатива .env — TOML-файл, путь к нему через BOBA_CONFIG_PATH.
#
# Пути к persistent-state (workspaces, logs, chroma) НЕ ставим в .env —
# они хардкодятся в launch.json (для local) и docker-compose.yml (для
# контейнера). См. ``local/README.md``.

# ---------- LLM (litellm-proxy) ----------
BOBA_LLM_BASE_URL=http://REPLACE-WITH-LLM-HOST:4000
BOBA_LLM_API_KEY=sk-REPLACE-WITH-LITELLM-API-KEY

# JWT-секрет chainlit. Генерация: ``openssl rand -hex 32``.
BOBA_CHAINLIT_AUTH_SECRET=replace-me-with-openssl-rand-hex-32

# ---------- Приложение ----------
# BOBA_APP_SSL_VERIFY=false
BOBA_APP_LOG_LEVEL=DEBUG

# ---------- Agent loop ----------
BOBA_AGENT_MAX_ITERATIONS=200
BOBA_AGENT_MAX_CONSECUTIVE_TOOL_CALLS=30

# ---------- Chainlit webserver ----------
BOBA_CHAINLIT_HOST=0.0.0.0
BOBA_CHAINLIT_PORT=8502
BOBA_CHAINLIT_ROOT_PATH=/boba-debug

# Список моделей для ChatSettings (CSV)
BOBA_CHAINLIT_MODELS=qwen3,qwen3-0.6b,qwen3-235b,qwen3.5-35b,qwen3.5-122b,deepseek-coder-v2-16b,qwen2.5-coder-1.5b,llama3.1-8b,gemini,numarkdown-q4,numarkdown-q8
