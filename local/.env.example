# Шаблон local/.env. Скопируйте в local/.env и подставьте реальные значения.
#
# Конвенция EnvSource: BOBA_<SEG>__<SEG>__<FIELD>
#   - префикс BOBA_, между префиксом и первым сегментом — одно `_`
#   - между сегментами и до поля — два `__`
#   - сегмент UPPER_CASE; внутри сегмента _ сохраняется (`fs_markdown`)
#
# Все ключи имеют дефолты в config.toml — здесь только секреты и
# окружение-зависимые поля. Пустую переменную не оставляйте; либо
# подставьте значение, либо закомментируйте.

# --- Путь к TOML-конфигу (специальный env для TomlSource, не секция) ---
BOBA_CONFIG_PATH=./local/config.toml

# --- [agent].log_file задаётся в config.toml: имя поля оканчивается на `_FILE`,
#     что коллидирует с конвенцией EnvFileSource (Docker secrets) и в env работать
#     не будет. ---

# --- [agent]: OpenAIConfig inline (LiteLLM / Ollama proxy) ---
BOBA_AGENT__BASE_URL=http://localhost:4000
BOBA_AGENT__API_KEY=sk-replace-me

# --- [chainlit]: secret для cookie-сессий (openssl rand -hex 32) ---
BOBA_CHAINLIT__AUTH_SECRET=generate-with-openssl-rand-hex-32

# --- [tool.chromadb]: endpoint embeddings-модели (если не default ONNX) ---
BOBA_TOOL__CHROMADB__EMBEDDING_BASE_URL=http://localhost:4000
BOBA_TOOL__CHROMADB__EMBEDDING_API_KEY=sk-replace-me

# --- [tool.confluence]: общий connection-блок для всех confluence-tools ---
BOBA_TOOL__CONFLUENCE__BASE_URL=https://confluence.example.com
BOBA_TOOL__CONFLUENCE__AUTH_TOKEN=replace-with-pat
