BOBA_CONFIG_PATH=./local/config.toml

# --- LLM (OpenAI-совместимый адаптер) ---
BOBA_ADAPTER_OPENAI_BASE_URL=http://REPLACE-WITH-LLM-HOST:4000
BOBA_ADAPTER_OPENAI_API_KEY=sk-REPLACE-WITH-LITELLM-API-KEY

# openssl rand -hex 32
BOBA_CHAINLIT_AUTH_SECRET=replace-me-with-openssl-rand-hex-32

# --- ChromaDB (общий backend для read-tools и indexer-store) ---
# Можно задать здесь или в TOML — env приоритетнее.
# BOBA_EXT__CHROMADB__PERSIST_PATH=./local/chroma

# --- Confluence-pipelines: per-mode env ---
# Каждый mode (space/pages/cql) имеет свою секцию [indexer.pipelines.confluence_<mode>]
# и собственную пару env-переменных. Если индексируешь только одним режимом —
# заполни только его пару. Двойное "__" экранирует точку в namespace'е.

# Режим: целый space → /rest/api/space/<key>/content
BOBA_INDEXER__PIPELINES__CONFLUENCE_SPACE__BASE_URL=https://confl.example.com
BOBA_INDEXER__PIPELINES__CONFLUENCE_SPACE__AUTH_TOKEN=replace-with-pat-or-password

# Режим: явный список page-id'ов
BOBA_INDEXER__PIPELINES__CONFLUENCE_PAGES__BASE_URL=https://confl.example.com
BOBA_INDEXER__PIPELINES__CONFLUENCE_PAGES__AUTH_TOKEN=replace-with-pat-or-password

# Режим: CQL-запрос → /rest/api/content/search
BOBA_INDEXER__PIPELINES__CONFLUENCE_CQL__BASE_URL=https://confl.example.com
BOBA_INDEXER__PIPELINES__CONFLUENCE_CQL__AUTH_TOKEN=replace-with-pat-or-password
