# Путь к TOML-конфигу (спец. env для root-загрузчика, не секция конфига).
BOBA_CONFIG_PATH=./local/config.toml

# Секреты подключаются в config.toml через ${oc.env:VAR,default}.
# Задайте переменные, чтобы переопределить дефолты из файла:
# BOBA_OPENAI_API_KEY=sk-or-...
# BOBA_PG_MAIN_PASSWORD=...
# BOBA_CHAINLIT_AUTH_SECRET=...
