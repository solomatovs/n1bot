# Шаблон local/.env. Скопируйте в local/.env и подставьте реальные значения.
#
# Конвенция EnvSource: BOBA_<SEG>__<SEG>__<FIELD>
#   - префикс BOBA_, между префиксом и первым сегментом — одно `_`
#   - между сегментами и до поля — два `__`
#   - сегмент UPPER_CASE; внутри сегмента _ сохраняется (`fs_markdown`)
#
# Все ключи имеют дефолты в config.toml — здесь только секреты и
# окружение-зависимые поля. Пустую переменную не оставляйте; либо
# подставьте значение, либо закомментируйте.

# --- Путь к TOML-конфигу (специальный env для TomlSource, не секция) ---
BOBA_CONFIG_PATH=./local/config.toml

# --- [app].log_file задаётся в config.toml: имя поля оканчивается на `_FILE`,
#     что коллидирует с конвенцией EnvFileSource (Docker secrets) и в env работать
#     не будет. ---

# --- [adapter.openai]: LiteLLM / Ollama proxy ---
BOBA_ADAPTER__OPENAI__BASE_URL=http://localhost:4000
BOBA_ADAPTER__OPENAI__API_KEY=sk-replace-me

# --- [chainlit]: secret для cookie-сессий (openssl rand -hex 32) ---
BOBA_CHAINLIT__AUTH_SECRET=generate-with-openssl-rand-hex-32

# --- [ext.chromadb]: endpoint embeddings-модели (если не default ONNX) ---
BOBA_EXT__CHROMADB__EMBEDDING_BASE_URL=http://localhost:4000
BOBA_EXT__CHROMADB__EMBEDDING_API_KEY=sk-replace-me

# --- [indexer.pipelines.confluence_*]: per-mode секреты ---
# Каждый mode (space/pages/cql) — отдельная секция, заполните только нужные.

# space: /rest/api/space/<key>/content
BOBA_INDEXER__PIPELINES__CONFLUENCE_SPACE__BASE_URL=https://confluence.example.com
BOBA_INDEXER__PIPELINES__CONFLUENCE_SPACE__AUTH_TOKEN=replace-with-pat

# pages: явный список page-id
BOBA_INDEXER__PIPELINES__CONFLUENCE_PAGES__BASE_URL=https://confluence.example.com
BOBA_INDEXER__PIPELINES__CONFLUENCE_PAGES__AUTH_TOKEN=replace-with-pat

# cql: /rest/api/content/search?cql=...
BOBA_INDEXER__PIPELINES__CONFLUENCE_CQL__BASE_URL=https://confluence.example.com
BOBA_INDEXER__PIPELINES__CONFLUENCE_CQL__AUTH_TOKEN=replace-with-pat

# --- [ext.confluence.search]: live-поиск Confluence (tool агента + CLI) ---
BOBA_EXT__CONFLUENCE__SEARCH__BASE_URL=https://confluence.example.com
BOBA_EXT__CONFLUENCE__SEARCH__AUTH_TOKEN=replace-with-pat

# --- [ext.confluence.page]: чтение конкретной страницы (page_outline + page_section) ---
BOBA_EXT__CONFLUENCE__PAGE__BASE_URL=https://confluence.example.com
BOBA_EXT__CONFLUENCE__PAGE__AUTH_TOKEN=replace-with-pat
