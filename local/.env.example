# Шаблон конфигурации для локального запуска. Скопируйте в local/.env
# и заполните реальными значениями. Сам .env gitignored (local/*),
# трекается только этот .env.example.
# Относительные пути — от cwd дебаг-сессии (${workspaceFolder}/.vscode).

# ---------- LLM (litellm-proxy) ----------
LLM_BASE_URL=http://REPLACE-WITH-LLM-HOST:4000
# LiteLLM proxy API key.
LITELLM_API_KEY=sk-REPLACE-WITH-LITELLM-API-KEY

# JWT-секрет chainlit. Генерация: `openssl rand -hex 32`.
CHAINLIT_AUTH_SECRET=replace-me-with-openssl-rand-hex-32

# ---------- Приложение ----------
# SSL_VERIFY=false
LOG_LEVEL=DEBUG
LOG_FILE=./logs/chainlit.log

# ---------- LLM sampling ----------
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.95
# LLM_MAX_TOKENS=4096
LLM_STOP=</s>,<|im_end|>
LLM_FREQUENCY_PENALTY=0.0
LLM_PRESENCE_PENALTY=0.1
LLM_PARALLEL_TOOL_CALLS=false

# ---------- Agent loop ----------
AGENT_MAX_ITERATIONS=200
AGENT_MAX_CONSECUTIVE_TOOL_CALLS=30
AGENT_MAX_CONSECUTIVE_FORMAT_FAILURES=30

# ---------- Workspaces ----------
WORKSPACE_BASE_DIR=./workspaces

# ---------- Chainlit webserver ----------
CHAINLIT_HOST=0.0.0.0
CHAINLIT_PORT=8502
CHAINLIT_ROOT_PATH=/boba-debug

# Список моделей для ChatSettings (CSV)
CHAINLIT_MODELS=qwen3,qwen3-0.6b,qwen3-235b,qwen3.5-35b,qwen3.5-122b,deepseek-coder-v2-16b,qwen2.5-coder-1.5b,llama3.1-8b,gemini,numarkdown-q4,numarkdown-q8
