# Шаблон секретов и tunables для локального запуска и docker-compose.
# Скопировать в ``local/.env`` и заполнить реальными значениями. Сам
# .env gitignored (см. .gitignore: ``/local/*``); трекается только этот
# .env.example.
#
# Используется в двух местах:
#  - VS Code launch.json: ``envFile: ${workspaceFolder}/local/.env``
#  - docker-compose.yml:  ``env_file: ./local/.env``
#
# Пути к persistent-state (workspaces, logs, chroma) НЕ ставим в .env —
# они хардкодятся в launch.json (для local) и docker-compose.yml (для
# контейнера). См. ``local/README.md``.

# ---------- LLM (litellm-proxy) ----------
LLM_BASE_URL=http://REPLACE-WITH-LLM-HOST:4000
LITELLM_API_KEY=sk-REPLACE-WITH-LITELLM-API-KEY

# JWT-секрет chainlit. Генерация: ``openssl rand -hex 32``.
CHAINLIT_AUTH_SECRET=replace-me-with-openssl-rand-hex-32

# ---------- Приложение ----------
# SSL_VERIFY=false
LOG_LEVEL=DEBUG

# ---------- LLM ----------
LLM_PARALLEL_TOOL_CALLS=false

# ---------- Agent loop ----------
AGENT_MAX_ITERATIONS=200
AGENT_MAX_CONSECUTIVE_TOOL_CALLS=30
AGENT_MAX_CONSECUTIVE_FORMAT_FAILURES=30

# ---------- Chainlit webserver ----------
CHAINLIT_HOST=0.0.0.0
CHAINLIT_PORT=8502
CHAINLIT_ROOT_PATH=/boba-debug

# Список моделей для ChatSettings (CSV)
CHAINLIT_MODELS=qwen3,qwen3-0.6b,qwen3-235b,qwen3.5-35b,qwen3.5-122b,deepseek-coder-v2-16b,qwen2.5-coder-1.5b,llama3.1-8b,gemini,numarkdown-q4,numarkdown-q8
