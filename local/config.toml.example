[app]
log_level = "DEBUG"
ssl_verify = false

[agent]
max_iterations = 200
max_consecutive_tool_calls = 30

[workspaces]
base_dir = "./local/workspaces"
user_subdir = "user"
system_subdir = "system"
tmp_subdir = "tmp"

[prompts]
dir = "./local/prompts"

[chainlit]
host = "0.0.0.0"
port = "8502"
root_path = "/boba-debug"
app_root = "./local/chainlit"
models = [
    "qwen3",
    "qwen3-0.6b",
    "qwen3-235b",
    "qwen3.5-35b",
    "qwen3.5-122b",
    "deepseek-coder-v2-16b",
    "qwen2.5-coder-1.5b",
    "llama3.1-8b",
    "gemini",
    "numarkdown-q4",
    "numarkdown-q8",
]

[ext.chromadb]
persist_path = "./local/chroma"
