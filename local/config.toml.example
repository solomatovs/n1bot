# Шаблон local/config.toml.
# Секции: [cli.agent], [chainlit], [tool.<name>]. Каждое приложение
# читает свою TOML-секцию; общая [agent] упразднена.
# Источник: $BOBA_CONFIG_PATH (по умолчанию ./local/config.toml).

[cli.agent]
model = ""
system_prompt_dir = "./local/prompts"
log_level = "INFO"
log_file = "./local/logs/cli.log"
user_workspace_dir = "./local/workspaces/user"
system_workspace_dir = "./local/workspaces/system"
base_url = "http://localhost:4000"     # → runtime.openai.base_url
api_key = "ollama"                     # → runtime.openai.api_key
# query = ""
# temperature = 0.7
# top_p = 0.9
# max_tokens = 4096
# seed = 0
# stop = []
# frequency_penalty = 0.0
# presence_penalty = 0.0

[chainlit]
model = ""
system_prompt_dir = "./local/prompts"
log_level = "INFO"
log_file = "./local/logs/chainlit.log"
user_workspace_dir = "./local/workspaces/user"
system_workspace_dir = "./local/workspaces/system"
base_url = "http://localhost:4000"
api_key = "ollama"
host = "0.0.0.0"
port = 8502
url_prefix = ""
auth_secret = ""                       # openssl rand -hex 32
headless = true
app_root = "./local/chainlit"
chat_session_pool_capacity = 32

# KB-плагин — 13 tools, allowlist через `tools=[...]`.
[tool.kb]
enable = false
tools = [
    "files_ingest",
    "confluence_space_ingest",
    "confluence_page_ingest",
    "kb_search",
    "vector_search",
    "confluence_search",
    "confluence_list_spaces",
    "fts_search",
    "confluence_page_download",
    "confluence_space_download",
    "sql_list_tables",
    "sql_describe_table",
    "sql_query",
]
collection = "knowledge_base"
collection_description = ""
files_folder = "./local/docs"
snippet_chars = 300
max_top_k = 20
rrf_k = 60
rrf_pool = 40
chunk_size = 4000
chunk_overlap = 0

[tool.kb.chunk_store]
schema = "public"
chunks_table = "kb_chunks"
collections_table = "kb_collections"

[tool.kb.postgres]
host = ""
port = 5432
user = ""
password = ""
database = ""
sslmode = "prefer"
application_name = "boba-tool-kb"
pool_min_size = 1
pool_max_size = 8
connect_timeout_sec = 10.0

# auth_method: pat | basic | none
[tool.kb.confluence]
base_url = ""
auth_method = "pat"
auth_token = ""
auth_user = ""
timeout_sec = 30.0
ssl_verify = false
body_format = "view"

[tool.kb.confluence.download]
dest_dir = "kb/confluence"             # workspace-relative
# attachment_media_types = []
# attachment_titles = []
# max_returned_files = 50

[tool.kb.embedding]
model = ""
base_url = ""
api_key = ""

[tool.kb.fts]
# dsn = ""
snippet_options = "MaxFragments=2,MaxWords=35,MinWords=15"
max_top_k = 20
# [tool.kb.fts.index]
# name = "docs"
# description = ""
# schema = "public"
# table = "documents"
# id_column = "id"
# tsv_column = "tsv"
# snippet_column = "body"
# language = "russian"
# metadata_columns = ["title", "source_url"]

# Ad-hoc SQL: read-only DSN (рекомендуется отдельная роль с GRANT SELECT).
[tool.kb.sql]
host = ""
port = 5432
user = ""
password = ""
database = ""
sslmode = "prefer"
application_name = "boba-tool-kb-sql"
pool_min_size = 1
pool_max_size = 4
connect_timeout_sec = 10.0
max_rows = 100
# max_cell_chars = 200                 # None — не обрезать
statement_timeout_ms = 5000

# Integration-test параметры для пакета boba-tool-kb (все поля опциональны).
[test.kb]
# kb_search_query = "как оформить возврат?"
# kb_search_top_k = 5
# confluence_page_ids = ["123456", "654321"]
# confluence_space_key = "DOCS"
# confluence_cql = "space = DOCS AND label = api"
# confluence_search_query = "consumer"
# confluence_search_space = "DOCS"
# fts_query = "auth"

[tool.files]
enable = false

[tool.html]
enable = false

# bash_local: subprocess без изоляции; bash_sandbox: bubblewrap.
# Регистрируется только если есть `bwrap` на хосте.
[tool.shell]
enable = false
# tools = ["bash_local"]

