# Шаблон local/config.toml. Скопируйте в local/config.toml и подставьте значения.
#
# Секции:
#   [agent]       — AppConfig (cli + chainlit) — плоская: поля распределяются
#                   валидатором по sub-моделям core/workspaces/openai.
#   [cli]         — AgentRunConfig (boba-cli-agent).
#   [chainlit]    — ChainlitConfig (boba-chainlit-agent).
#   [tool.<name>] — конфиги tool-плагинов (discovery + enable-флаг).
#
# Источник: $BOBA_CONFIG_PATH (по умолчанию ./local/config.toml).
# Env override:
#   BOBA_AGENT__BASE_URL=...      → openai.base_url
#   BOBA_AGENT__LOG_LEVEL=DEBUG   → core.log_level
#   BOBA_CLI__MODEL=...           → AgentRunConfig.model
#   BOBA_CHAINLIT__MODEL=...      → ChainlitConfig.model

# --- AppConfig: плоский [agent] (поля собираются в core/workspaces/openai) -----
[agent]
# system_prompt_dir — обязательное поле верхнего уровня.
system_prompt_dir = "./local/prompts"
# core
log_level = "INFO"
ssl_verify = false
log_file = "./local/logs/boba.log"
# workspaces
base_dir = "./local/workspaces"
user_subdir = "user"
system_subdir = "system"
tmp_subdir = "tmp"
# openai (base_url/api_key обычно перекрываются env'ом)
base_url = "http://localhost:4000"
api_key = "ollama"

# --- boba-cli-agent ---
# model обязателен; query пусто → REPL, query задан → single-shot.
# Эти же поля можно перебить через CLI argv: boba-cli-agent --model X --query "..."
[cli]
model = ""
# query = ""
# temperature = 0.7
# top_p = 0.9
# max_tokens = 4096
# seed = 0
# stop = []
# frequency_penalty = 0.0
# presence_penalty = 0.0

# --- boba-chainlit-agent ---
# model и auth_secret обязательны.
[chainlit]
model = ""
host = "0.0.0.0"
port = 8502
root_path = ""
# Секрет для подписи user-session cookie. Обязателен.
# Сгенерировать: `openssl rand -hex 32`. В проде задавать через env
# BOBA_CHAINLIT__AUTH_SECRET, чтобы не коммитить в TOML.
auth_secret = ""
# Единственный user — для multi-user будет отдельная [auth.users].
headless = true
app_root = "./local/chainlit"
# Сколько ChatSession держать в RAM одновременно (LRU eviction).
chat_session_pool_capacity = 32

# --- tool-плагины (entry_points discovery; enable=false => плагин пропускается) ---
# env-конвенции:
#   BOBA_TOOL__<PLUGIN_NAME>__<FIELD>=...
# Например: BOBA_TOOL__KB__CONFLUENCE__BASE_URL=https://confluence.example.com

# Postgres + pgvector KB-плагин: KB-tools (kb_search/kb_list_collections/
# kb_ingest/kb_ingest_confluence) + Confluence read-side tools (search,
# page_outline, page_section, page_download, page_download_markdown) +
# External-FTS tools (fts_search/fts_list_indexes — read-only по чужим
# таблицам оператора).
[tool.kb]
enable = false
# Allowlist по wire-имени tool'а. Если опущен — регистрируются все 11.
# Здесь перечислены все доступные tools — закомментируйте лишние или
# замените на суженный список.
tools = [
    "kb_search",
    "kb_list_collections",
    "kb_ingest",
    "kb_ingest_confluence",
    "confluence_search",
    "confluence_page_outline",
    "confluence_page_section",
    "confluence_page_download",
    "confluence_page_download_markdown",
    "fts_search",
    "fts_list_indexes",
]
# DSN PostgreSQL (с pgvector + tsvector). Обязателен.
dsn = ""
# Минимальный/максимальный размер connection pool'а (psycopg_pool).
pool_min_size = 1
pool_max_size = 8
# PostgreSQL text search configuration для tsvector. Меняется только
# пересозданием kb_chunks (см. migrations/001_init.sql).
fts_language = "russian"
# Embedding model (общая для ingest и kb_search). OpenAI-совместимый endpoint
# (LiteLLM / OpenAI / vLLM / Ollama). Пустая строка — ingest и kb_search
# падают fail-fast (оператор обязан задуматься).
embedding_model = ""
embedding_base_url = ""
embedding_api_key = ""
snippet_chars = 300
max_top_k = 20
# RRF (Reciprocal Rank Fusion): k=60 — стандарт литературы; pool=40 — сколько
# top-K брать из каждого канала (vector + FTS) перед склейкой.
rrf_k = 60
rrf_pool = 40
# Chunking. chunk_size — целевой размер `format_content` чанка в символах;
# chunk_overlap — перекрытие между соседними чанками (0 = без перекрытия).
chunk_size = 4000
chunk_overlap = 0
# Параметры FS-ingest (`kb_ingest`), заранее закреплённые оператором. LLM не
# выбирает folder/collection — это защита от случайного индексирования чужих
# файлов. Пустой ingest_folder = FS-ingest выключен.
ingest_folder = ""
ingest_collection = "knowledge_base"
ingest_collection_description = ""

# Confluence connection-блок (общий для всех confluence-tools и для
# kb_ingest_confluence). Секреты обычно из env: BOBA_TOOL__KB__CONFLUENCE__*.
#
# auth_method:
#   - "pat"    — Bearer-токен (Atlassian Personal Access Token); auth_token обязателен.
#   - "basic"  — login+password; auth_user + auth_token обязательны.
#   - "none"   — anonymous read (для публичных Confluence — cwiki.apache.org и т.п.).
#                Удобно для integration-тестов без секретов:
#                  base_url = "https://cwiki.apache.org/confluence"
#                  auth_method = "none"
[tool.kb.confluence]
base_url = ""
auth_method = "pat"          # pat | basic | none
auth_token = ""              # требуется при pat/basic
auth_user = ""               # требуется при basic
timeout_sec = 30.0
ssl_verify = false
body_format = "view"         # view | export_view | storage

# Параметры Confluence-ingest (`kb_ingest_confluence`), заранее закреплённые
# оператором. source_type выбирает обязательное поле (space_key/cql/page_ids).
[tool.kb.confluence_ingest]
source_type = "space"        # space | cql | pages
space_key = ""               # обязателен при source_type=space
cql = ""                     # обязателен при source_type=cql
page_ids = []                # обязателен при source_type=pages
collection = "confluence_kb"
collection_description = ""

# External-FTS: read-only поиск по чужим таблицам оператора через
# whitelist tsvector-индексов. Не путать с FTS-каналом kb_search,
# который работает по `kb_chunks` (наполняется нашими ingest-tools).
# DSN пуст → переиспользуется [tool.kb].dsn (тот же PostgresPool).
[tool.kb.external_fts]
# dsn = ""                  # если задан, должен включать ?default_transaction_read_only=on
snippet_options = "MaxFragments=2,MaxWords=35,MinWords=15"
max_top_k = 20
# Whitelist индексов — массив таблиц [[tool.kb.external_fts.indexes]]:
# [[tool.kb.external_fts.indexes]]
# name = "docs"
# description = "Документация продукта; для подсказок по фичам."
# schema = "public"
# table = "documents"
# id_column = "id"
# tsv_column = "tsv"
# snippet_column = "body"
# language = "russian"
# metadata_columns = ["title", "source_url"]

# Integration-test параметры для пакета boba-tool-kb. Читаются классом
# KbIntegrationTestConfig из tests/conftest.py. Все поля опциональны:
# конкретный тест скипается, если нужное поле пусто. Запуск:
#   pytest packages/tools/boba-tool-kb -m integration -s
[test.kb]
# kb_search_query = "как оформить возврат?"
# kb_search_top_k = 5
# confluence_page_ids = ["123456", "654321"]
# confluence_space_key = "DOCS"
# confluence_cql = "space = DOCS AND label = api"
# fts_index_name = "docs"
# fts_query = "auth"

# per-tool PromptOverlay (опционально, описание/fields LLM'у):
#   [tool.kb.kb_search]
#   description = ""
#   fields = {}
#   [tool.kb.kb_ingest_confluence]
#   description = ""
#   fields = {}
#   [tool.kb.fts_search]
#   description = ""
#   fields = {}

# 15 файловых tools под общим enable-флагом
[tool.files]
enable = false
# [tool.files.cat]
# max_lines = 2000
# [tool.files.cat.prompt]
# description = ""
# fields = {}
# PromptOverlay по остальным tools: append/cd/cp/edit/grep/ls/mkdir/mv/pwd/rm/stat/touch/tree/write

# html_outline + html_section (работают по workspace)
[tool.html]
enable = false
# [tool.html.html_outline]
# description = ""
# fields = {}
# [tool.html.html_section]
# description = ""
# fields = {}

# shell-плагин — два независимых @tool:
#   - bash_local:   прямой subprocess.Popen без изоляции (под доверенный dev).
#   - bash_sandbox: bubblewrap-песочница с явным реестром профилей.
#                   Регистрируется только если на хосте есть `bwrap`.
#
# Селекция — через `tools=[...]` allowlist (стандартный PluginConfigBase).
# Конфиги обоих tool'ов живут отдельными секциями [tool.bash_local] и
# [tool.bash_sandbox]; при отсутствии в TOML — берутся дефолты (для
# bash_sandbox пустые profiles означают: tool зарегистрирован, но при
# вызове вернёт unknown_profile-payload).
[tool.shell]
enable = false
# Allowlist по wire-имени tool'а. Если опущен — регистрируются оба.
# tools = ["bash_local"]

# --- bash_local: subprocess без изоляции (dev-only) --------------------------
# [tool.bash_local]
# workspace_root = "."         # cwd по умолчанию для subprocess
# cwd = ""                     # пусто → workspace_root
# env_passthrough = ["PATH", "HOME", "USER", "LANG", "LC_ALL", "TERM"]
# env_set = {}                 # перекрывает env_passthrough при коллизии имён
# timeout_sec = 30             # 1..3600
# max_output_bytes = 262144    # ≥1024; отдельно для stdout/stderr

# --- bash_sandbox: bubblewrap (требует `bwrap` на хосте) ---------------------
# [tool.bash_sandbox]
# workspace_root = "."         # RW-bind в песочнице + cwd для запуска bwrap
# default_profile = "default"  # имя default-профиля из profiles ниже
#
# [tool.bash_sandbox.profiles.default]
# ro_binds = ["/usr", "/bin", "/sbin", "/lib", "/lib64",
#             "/etc/alternatives", "/etc/resolv.conf"]
# rw_binds = []                # workspace_root добавляется автоматически
# tmpfs = ["/tmp"]
# network = false              # false → --unshare-net (нет сети)
# env_set = { PATH = "/usr/bin:/bin" }  # host-env НЕ наследуется
# timeout_sec = 30             # 1..3600
# max_output_bytes = 262144    # ≥1024; отдельно для stdout/stderr
# cwd = ""                     # пусто → workspace_root

# Все KB-каналы (наша KB + Confluence + External-FTS) живут под зонтиком
# [tool.kb]. См. секции [tool.kb] / [tool.kb.confluence] /
# [tool.kb.confluence_ingest] / [tool.kb.external_fts] выше.
