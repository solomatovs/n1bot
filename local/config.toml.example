# Шаблон local/config.toml. Скопируйте в local/config.toml и подставьте значения.
#
# Секции:
#   [agent]       — AppConfig (cli + chainlit): inline-композит
#                    core + workspaces + openai + prompts + runtime.
#   [cli]         — AgentRunConfig (boba-cli-agent).
#   [chainlit]    — ChainlitConfig (boba-chainlit-agent).
#   [tool.<name>] — конфиги tool-плагинов (discovery + enable-флаг).

# --- AppConfig: inline core + workspaces + openai + prompts + runtime ---
[agent]
# core
log_level = "INFO"
ssl_verify = false
log_file = "./local/logs/boba.log"
# workspaces
base_dir = "./local/workspaces"
user_subdir = "user"
system_subdir = "system"
tmp_subdir = "tmp"
# openai (base_url/api_key обычно перекрываются env'ом)
base_url = "http://localhost:4000"
api_key = "ollama"
# prompts
dir = "./local/prompts"
# runtime
max_iterations = 20
max_consecutive_tool_calls = 3

# --- boba-cli-agent ---
# model обязателен; query пусто → REPL, query задан → single-shot
[cli]
model = ""
query = ""
# temperature = 0.7
# top_p = 0.9
# max_tokens = 4096
# seed = 0
# stop = []
# frequency_penalty = 0.0
# presence_penalty = 0.0

# --- boba-chainlit-agent ---
# model обязателен (используется для всех запросов из UI)
[chainlit]
model = ""
host = "0.0.0.0"
port = "8501"
root_path = ""
# auth_secret обычно из env (openssl rand -hex 32)
headless = "true"
app_root = "./local/chainlit"
# ui_name = ""
# enable_telemetry = false
# upload_max_size_mb = 25
# upload_max_files = 5
# upload_accept = ["text/*", "application/pdf"]

# --- tool-плагины (entry_points discovery; enable=false => плагин пропускается) ---

# kb_search + kb_list_collections (read-only)
[tool.chromadb]
enable = false
persist_path = "./local/chroma"
# "default" = built-in ONNX all-MiniLM-L6-v2 (локально, без сети).
# Иначе — модель LiteLLM/OpenAI-API; base_url/api_key обычно из env.
embedding_model = "default"
embedding_base_url = ""
embedding_api_key = ""
snippet_chars = 300
max_top_k = 20
# per-tool PromptOverlay: description + fields:
#   [tool.chromadb.kb_search]
#   description = ""
#   fields = {}

# 15 файловых tools под общим enable-флагом
[tool.files]
enable = false
# [tool.files.cat]
# max_lines = 2000
# [tool.files.cat.prompt]
# description = ""
# fields = {}
# PromptOverlay по остальным tools: append/cd/cp/edit/grep/ls/mkdir/mv/pwd/rm/stat/touch/tree/write

# html_outline + html_section (работают по workspace)
[tool.html]
enable = false
# [tool.html.html_outline]
# description = ""
# fields = {}
# [tool.html.html_section]
# description = ""
# fields = {}

# confluence_search + confluence_page_outline + confluence_page_section
# (общий connection-блок на корне плагина; base_url/auth_token обычно из env)
[tool.confluence]
enable = false
base_url = ""
auth_token = ""
auth_method = "pat"          # pat | basic
auth_user = ""               # только для basic-auth
timeout_sec = 30.0
body_format = "view"         # view | export_view | storage
# [tool.confluence.confluence_search]
# description = ""
# fields = {}
# [tool.confluence.confluence_page_outline]
# description = ""
# fields = {}
# [tool.confluence.confluence_page_section]
# description = ""
# fields = {}
