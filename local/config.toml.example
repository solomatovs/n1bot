[app]
log_level = "INFO"
ssl_verify = false
log_file = "./local/logs/boba.log"

[agent]
max_iterations = 20
max_consecutive_tool_calls = 3

[adapter.openai]
base_url = "http://localhost:4000"
api_key = "ollama"

[workspaces]
base_dir = "./local/workspaces"
user_subdir = "user"
system_subdir = "system"
tmp_subdir = "tmp"

[prompts]
dir = "./local/prompts"

[chainlit]
host = "0.0.0.0"
port = "8501"
root_path = ""
auth_secret = ""
headless = "true"
app_root = "./local/chainlit"
models = []
ui_name = ""
enable_telemetry = ""
upload_max_size_mb = ""
upload_max_files = ""
upload_accept = ""

[ext.chromadb]
persist_path = "./local/chroma"
embedding_model = "default"

[ext.chromadb.tools]
enable = false
tools_allow = []
snippet_chars = 300

[ext.chromadb.tools.kb_search]
description = ""
max_top_k = 20
params = {}

[ext.chromadb.tools.kb_list_collections]
description = ""
params = {}

[ext.files]
enable = false
tools_allow = []

[ext.files.tools.cat]
description = ""
max_lines = 2000
params = {}

[ext.files.tools.ls]
description = ""
params = {}

[ext.files.tools.grep]
description = ""
params = {}

[ext.files.tools.edit]
description = ""
params = {}

[ext.files.tools.write]
description = ""
params = {}

[ext.files.tools.cp]
description = ""
params = {}

[ext.files.tools.mv]
description = ""
params = {}

[ext.files.tools.rm]
description = ""
params = {}

[ext.files.tools.mkdir]
description = ""
params = {}

[ext.files.tools.touch]
description = ""
params = {}

[ext.files.tools.stat]
description = ""
params = {}

[ext.files.tools.pwd]
description = ""

[ext.files.tools.cd]
description = ""
params = {}

[ext.files.tools.tree]
description = ""
params = {}

[ext.files.tools.append]
description = ""
params = {}

[ext.html]
enable = false
tools_allow = []

[ext.html.tools.html_outline]
description = ""
params = {}

[ext.html.tools.html_section]
description = ""
params = {}

[ext.confluence]
enable = false
tools_allow = []

[ext.confluence.tools.confluence_outline]
description = ""
params = {}

[ext.confluence.tools.confluence_section]
description = ""
params = {}

[agent_run]
query = ""
model = ""
temperature = ""
top_p = ""
max_tokens = ""
seed = ""
stop = ""
frequency_penalty = ""
presence_penalty = ""

# action ставится только per-launch (CLI/env), в TOML обычно не хранится.
[vector_index]
verbose = 0

[vector_index.index]
collection = ""
pipeline = ""                # ext.fs_markdown | ext.fs_html | ext.fs_text | ext.confluence_space | ext.confluence_pages | ext.confluence_cql
description = ""

[vector_index.sync]
collection = ""
pipeline = ""

[vector_index.show]
collection = ""
source_id = ""
limit = 20
snippet_chars = 200

[vector_index.delete]
collection = ""

[indexer.pipelines.fs_markdown]
paths = []
include = []
exclude = []
follow_symlinks = false
chunk_size = 1500
chunk_overlap = 150

[indexer.pipelines.fs_html]
paths = []
include = []
exclude = []
follow_symlinks = false
chunk_size = 1500
chunk_overlap = 150

[indexer.pipelines.fs_text]
paths = []
include = []
exclude = []
follow_symlinks = false
chunk_size = 1000
chunk_overlap = 200

# base_url + auth_token задавать через env (BOBA_INDEXER__PIPELINES__CONFLUENCE_<MODE>__BASE_URL/__AUTH_TOKEN)
[indexer.pipelines.confluence_space]
base_url = ""
auth_method = "pat"          # pat | basic
auth_user = ""
auth_token = ""
space_key = ""
body_format = "export_view"  # export_view | view | storage
timeout_sec = 30.0
chunk_size = 1500
chunk_overlap = 150

[indexer.pipelines.confluence_pages]
base_url = ""
auth_method = "pat"
auth_user = ""
auth_token = ""
page_ids = []
body_format = "export_view"
timeout_sec = 30.0
chunk_size = 1500
chunk_overlap = 150

[indexer.pipelines.confluence_cql]
base_url = ""
auth_method = "pat"
auth_user = ""
auth_token = ""
cql = ""
body_format = "export_view"
timeout_sec = 30.0
chunk_size = 1500
chunk_overlap = 150
