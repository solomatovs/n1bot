[app]
log_level = "DEBUG"
ssl_verify = false
# log_file = "./local/logs/boba.log"

[adapter.openai]
base_url = "http://localhost:4000"
api_key = "ollama"

[agent]
max_iterations = 200
max_consecutive_tool_calls = 30

[workspaces]
base_dir = "./local/workspaces"
user_subdir = "user"
system_subdir = "system"
tmp_subdir = "tmp"

[prompts]
dir = "./local/prompts"

[chainlit]
host = "0.0.0.0"
port = "8502"
root_path = "/boba-debug"
headless = "true"
app_root = "./local/chainlit"
models = [
    "qwen3",
    "qwen3-0.6b",
    "qwen3-235b",
    "qwen3.5-35b",
    "qwen3.5-122b",
    "deepseek-coder-v2-16b",
    "qwen2.5-coder-1.5b",
    "llama3.1-8b",
    "gemini",
    "numarkdown-q4",
    "numarkdown-q8",
]
# auth_secret = "..."
# ui_name = "Boba"
# enable_telemetry = false
# upload_max_size_mb = 25
# upload_max_files = 5
# upload_accept = ["text/*", "application/pdf"]

# Tool-расширения подключаются явно — секцией [ext.<name>] enable=true
# (для html/confluence/files) или [ext.<name>.tools] enable=true (chromadb).
# tools_allow внутри секции — опциональный whitelist по именам tools.

[ext.files]
enable = false
tools_allow = []  # ["cat", "ls", "grep", ...]

[ext.html]
enable = false

[ext.confluence]
enable = false

# ChromaDB разделён на два слоя:
#   [ext.chromadb]       — общий backend (persist_path, embedding_model)
#                          для read-tools и write-store.
#   [ext.chromadb.tools] — гейт + параметры read-only KB tools для агента.
[ext.chromadb]
persist_path = "./local/chroma"
embedding_model = "default"

[ext.chromadb.tools]
enable = false
tools_allow = []  # ["kb_search", "kb_list_collections"]
snippet_chars = 300

# Per-tool секции — необязательные overrides описаний/лимитов.
# [ext.chromadb.tools.kb_search]
# max_top_k = 20

# CLI-секции (boba-cli-agent-run / boba-cli-vector-index).
# Обычно задаются через CLI-аргументы; здесь — дефолты.

[agent_run]
# model = "qwen3.5-35b"
# query = "..."
# temperature = 0.2
# top_p = 0.9
# max_tokens = 4096
# seed = 42
# stop = []
# frequency_penalty = 0.0
# presence_penalty = 0.0

# CLI-индексатор: action + выбор pluggable Source/Chunker/Store по id.
# Source обычно меняется per-launch (FS / Confluence / ...) и задаётся через
# CLI/launch.json. Chunker/Store фиксируются в TOML — они общие для всех
# launch-конфигов.
[vector_index]
confirm_skip = false
verbose = 1
source = "ext.fs"                   # default; override через --vector_index.source=...
chunker = "ext.heading"             # heading-aware: anchor сохраняется, без cross-section bleed
store = "ext.chromadb_persist"
# action = "index"          # index | list | delete
# collection = "manual"
# description = "Confluence-export'ы"

# Параметры FsSource (paths/include/exclude).
[indexer.sources.fs]
# paths = ["./local/manual"]
# include = []              # ["*.md", "*.html"]
# exclude = []
# follow_symlinks = false

# Параметры sliding chunker'а.
[indexer.chunkers.sliding]
chunk_size = 1000
chunk_overlap = 200

# Heading-aware chunker (анкоры наследуются, без cross-section bleed).
[indexer.chunkers.heading]
chunk_size = 1500
chunk_overlap = 150

# Confluence-source: общие параметры backend + auth.
# Чувствительные значения задаются через env (не TOML):
#   BOBA_INDEXER__SOURCES__CONFLUENCE__BASE_URL=https://confl.example.com
#   BOBA_INDEXER__SOURCES__CONFLUENCE__AUTH_TOKEN=<PAT-или-password>
[indexer.sources.confluence]
# auth_method = "pat"          # "pat" | "basic"
# auth_user = ""               # для basic; PAT — игнорируется
# body_format = "export_view"  # "export_view" | "view" | "storage"
# timeout_sec = 30.0

# Per-mode параметры:
[indexer.sources.confluence.space]
# space_key = "DOCS"

[indexer.sources.confluence.pages]
# page_ids = ["12345", "67890"]

[indexer.sources.confluence.cql]
# cql = "space = DOCS AND lastModified > '2024-01-01'"
