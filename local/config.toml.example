# boba-cli-agent
[cli.agent]
model = "qwen/qwen3.7-max"
max_messages = 30
system_prompt_dir = "./local/prompts"
log_level = "INFO"
log_file = "./local/logs/cli.log"
user_workspace_dir = "./local/workspaces/user"
system_workspace_dir = "./local/workspaces/system"
base_url = "https://localhost:4000"
api_key = ""
# query = "О чем говориться в контексте?"
# temperature = 0.7
# top_p = 0.9
# max_tokens = 4096
# seed = 0
# stop = []
# frequency_penalty = 0.0
# presence_penalty = 0.0

# boba-chainlit-agent
[chainlit]
model = "qwen/qwen3.7-max"
# model = "qwen/qwen3-32b"
# model = "qwen/qwen3-8b"
# model = "qwen/qwen3-max"
# model = "qwen/qwen3-max-thinking"
# model = "qwen/qwen3-next-80b-a3b-thinking"
# model = "nvidia/nemotron-3-nano-30b-a3b:free"
max_messages = 30
system_prompt_dir = "./local/prompts"
log_level = "INFO"
log_file = "./local/logs/chainlit.log"
user_workspace_dir = "./local/workspaces/user"
system_workspace_dir = "./local/workspaces/system"
base_url = "https://localhost:4000"
api_key = ""
host = "0.0.0.0"
port = 8502
url_prefix = "/boba-debug"
# chainlit auth_secret: openssl rand -hex 32
auth_secret = ""
headless = true
app_root = "./local/chainlit"
chat_session_pool_capacity = 32

# На каждый postgres connection — отдельная секция [postgres.<name>].
# connection-параметры
[postgres.main]
host = "127.0.0.1"
port = 5432
user = "postgres"
password = ""
database = "postgres"
sslmode = "disable"
application_name = "boba"
pool_min_size = 1
pool_max_size = 8
connect_timeout_sec = 10.0
statement_timeout_ms = 5000


# Общие параметры подключения в embeding модели
[embedding]
# provider = "openai-compat"
# endpoint = "https://localhost:4000"
# api_key = ""
# model = "intfloat/multilingual-e5-large"
provider = "local"
model = "intfloat/multilingual-e5-large"
cache_dir = "./local/cache/fastembed"


# Общие параметры подключения к confluence
[confluence]
base_url = "https://cwiki.apache.org/confluence"
# none, pat, basic
auth_method = "none"
auth_token = ""
auth_user = ""
timeout_sec = 30.0
ssl_verify = true
body_format = "view"


# Shared параметры для KB:
[kb.storage]
profile = "main"
application_name = "boba-kb"
pg_schema = "public"
chunks_table = "kb_chunks"
collections_table = "kb_collections"
batch_size = 100


# инструмент поиска по базе знаний confluence
[tool.kb]
enable = true
tools = [
    # ingest (Confluence → kb_chunks)
    "confluence_ingest_spaces",   # все страницы перечисленных spaces
    "confluence_ingest_pages",    # явный список page_id
    "confluence_ingest_cql",      # discovery через CQL-запрос
    # search (KB / online)
    "kb_vector_search",       # kb_confluence, семантический (cosine)
    "kb_fts_search",          # kb_confluence, лексический (ts_rank_cd)
    "kb_doc_vector_search",   # kb_confluence_doc, семантический
    "kb_doc_fts_search",      # kb_confluence_doc, лексический
    "confluence_search_cql",
    "confluence_list_spaces",
    # download / fetch (Confluence → workspace / напрямую LLM)
    "confluence_download",        # unified: space_keys / page_ids
    "confluence_fetch_page",      # одна страница строкой, без записи на диск
    "confluence_grep_page",       # grep по одной странице, только совпадения
]

# Индексирует confluence страницы
[tool.kb.confluence.ingest]
chunk_size = 4000
chunk_overlap = 0
collection = "kb_confluence"
# Allowlist-фильтры вложений (fnmatch-globs; OR между списками; пустые → все вложения).
attachment_media_types = []
attachment_titles = []


# tool для скачивания confluence страниц.
# dest_dir — workspace-relative (внутри session-workspace, не FS-путь).
[tool.kb.confluence.download]
dest_dir = "kb/confluence"
attachment_media_types = []
attachment_titles = []

# tool для поиска по confluence
[tool.kb.confluence.search.cql]
snippet_chars = 300
max_limit = 50

# tool для grep'а по одной confluence странице (потоковый fetch + regex-поиск).
# Возвращает только совпадения с номерами строк, а не весь контент.
[tool.kb.confluence.grep]
max_text_chars = 2000   # потолок длины content/before/after на каждый match


# KB search: общий конфиг для 4 tool'ов (kb_{vector,fts}_search /
# kb_doc_{vector,fts}_search). Канал и коллекция зашиты в сам tool;
# strict-фильтр по collection (kb_confluence / kb_confluence_doc).
[tool.kb.search]
snippet_chars = 300
max_top_k = 20
# SQL-шаблоны vector/fts встроены в код (KbSearch.VECTOR_SQL / FTS_SQL).


# cli для накатырвания миграции в postgres
# создание kb таблиц 
[cli.kb.bootstrap]


# cli для индексации чанков, подготовленных оператором
# документы должны быть подготовлены в формате:
# 1 .md файл = 1 чанк
[cli.kb.confluence_doc.ingest]
chunk_size = 4000
chunk_overlap = 0
folder = "./local/docs"
collection = "kb_confluence_doc"
prune = false


# cli для запуска индексации confluence
[cli.kb.confluence.ingest]
chunk_size = 4000
chunk_overlap = 0
collection = "kb_confluence"
space_type = "global"
only = []
skip = []
page_ids = []
prune = false
# Allowlist-фильтры вложений (fnmatch-globs; OR между списками; пустые → все вложения).
# Примеры: ["application/pdf", "image/*"] или ["*.pdf", "report-*.docx"].
attachment_media_types = ["image/*"]
attachment_titles = []


# cli для рендеринга sql запроса
# позволяет оператору посмотреть sql запрос
# который будет отправлен llm в postgres
# для нахождения чанков
[cli.kb.search.render]
# Дефолты для запуска без CLI-флагов; --template/--query/--top-k override'ят.
template = "fts"
query = "как оформить возврат?"
top_k = 5


# cli для скачивания confluence страниц на файловую систему.
# dest_dir — FS-путь относительно CWD.
[cli.kb.confluence.download]
dest_dir = "./local/downloads"
as_markdown = true
space_type = "global"
only = []
skip = []
page_ids = []
# Allowlist-фильтры вложений (fnmatch-globs; OR между списками; пустые → все вложения).
# Отсеянные не запрашиваются по HTTP и не пишутся на диск.
attachment_media_types = []
attachment_titles = []


# Выполняет запросы в postgres.
[tool.pg]
enable = false
tools = [
    "list_targets",
    "query",
    "list_tables",
    "describe_table",
]
# доступные для работы профили
profiles = [
    "main"
]
max_rows = 100
max_cell_chars = 2000


# tools для работы с файлами
[tool.files]
enable = true
tools = [
    "append",
    "cat",
    "read_bytes",
    "grep",
    "ls",
    "stat",
    "tree",
    "unzip",
    # "cd",
    # "cp",
    # "edit",
    # "mkdir",
    # "mv",
    # "pwd",
    # "rm",
    # "touch",
    # "write",
]
cat_max_chars = 50000


# Чтение и поиск по загруженным документам (liteparse)
[tool.doc]
enable = true
tools = [
    "read_document",
    "read_pages",
    "document_outline",
    "search_document",
]
# OCR выключен по умолчанию: для текстовых PDF не нужен, требует tesseract.
ocr_enabled = false
ocr_language = "rus+eng"
max_pages = 0
max_text_chars = 200000
search_context_chars = 80
search_max_matches = 50

# tool для запуска bash скриптов
# опасный tool, используем только для тестов
[tool.shell]
enable = false
tools = [
    "bash_local",
    "bash_sandbox",
]


# web-профили (hostname + auth)
[web.raw_github]
hostname = "raw.githubusercontent.com"
[web.raw_github.auth]
method = "none"

[web.github]
hostname = "github.com"
[web.github.auth]
method = "none"

[web.google]
hostname = "www.google.com"
[web.google.auth]
method = "none"


# tool для выполнения web request'ов
[tool.web]
enable = true
tools = [
    "web_fetch",
    "web_download",
    "web_grep"
]
# профили доступные для работы tool.web
profiles = [
    "raw_github",
    "github",
    "google"
]

timeout_sec = 30.0
ssl_verify = true

[tool.web.download]
dest_dir = "web/downloads"                # workspace-relative
# max_returned_files = 50

[tool.web.grep]
# max_text_chars = 2000                   # потолок длины content/before/after на match
