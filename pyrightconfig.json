{
  "include": [
    "src/boba-domain/src",
    "src/boba-app/src",
    "src/boba-adapters/src",
    "src/boba-infra/src",
    "src/boba-api/src",
    "src/boba-chainlit/src",
    "tests"
  ],
  "extraPaths": [
    "src/boba-domain/src",
    "src/boba-app/src",
    "src/boba-adapters/src",
