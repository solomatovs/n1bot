{
  "include": [
    "src/domain/src",
    "src/app/src",
    "src/adapters/src",
    "src/infra/src",
    "src/api/src",
    "src/chainlit/src",
    "tests"
  ],
  "extraPaths": [
    "src/domain/src",
    "src/app/src",
    "src/adapters/src",
    "src/infra/src",
    "src/api/src",
    "src/chainlit/src"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.11",
  "typeCheckingMode": "basic",
  "reportMissingImports": true,
  "reportMissingTypeStubs": false,
  "reportUnusedImport": true,
  "reportUnusedVariable": true
}
